# Gradle / Android 构建产物
.gradle/
.gradle-user-home/
.pnpm-store/
build/
app/build/
captures/
*.apk
*.aab

# Python 缓存
__pycache__/
*.pyc
node_modules/

# 本机配置（不提交）
local.properties
.idea/
*.iml
.DS_Store

# 离线 rootfs：不提交，CI 现场生成（AGENTS.md 约定；304MB 也超 git 单文件硬限）
app/src/main/assets/offline-rootfs.bin
app/src/main/assets/dsh-runtime.bin
app/src/main/assets/dsh-runtime.inputs.json
app/src/main/assets/ubuntu-tools.bin
app/src/main/assets/ubuntu-tools.inputs.json
app/src/main/assets/glibc-python.tar.gz
app/src/main/assets/adb-wheels.tar.gz
app/src/main/assets/gh-cli.tar.gz
app/src/main/assets/pnpm-runtime.bin
app/src/main/assets/python-support.bin

# 发布 APK：走 GitHub Release 资产，不进 git
release/*.apk
release/*.sha256
release/_data_backup/
release/history/

# build195 起 Java 编译依赖的固定输入：由 tools/ci-assets.py 按锁定 URL/SHA 还原，不入库
app/libs/

# 本地临时/中间产物
tmp_*/
tmp-*/
tools/offline-rootfs-old-v8.bin
python-runtime.tgz
scr_backup.png

# 本机工具状态与服务器取证，不进入公开仓库
.zcode/
website-evidence/
