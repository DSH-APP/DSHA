        "runtime-trial-plugin.js"
      ]
    },
    {
      "source": "app/src/main/java/com/deepseekharness/app/ui/WebPageScripts.java",
      "method": "read(context,path)",
      "contract": "Exact page compatibility/locale/back integration; ES5 token shim also enters generated Gecko content.",
