    {
      "source": "app/src/main/java/com/deepseekharness/app/ui/AboutFragment.java",
      "method": "showLicenses assets.list(licenses) and assets.open(licenses/name)",
      "contract": "The complete signed license tree is retained; user-visible license content is enumerated only from that packaged directory. Entry names are validated by the reader, not arbitrary user paths.",
