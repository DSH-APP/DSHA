        "runtime-descriptor.json",
        "offline-rootfs.version",
        "offline-rootfs.bytes",
        "offline-rootfs.layout",
        "offline-rootfs.bin",
        "dsh-runtime.bin",
        "ubuntu-tools.bin"
      ]
    },
    {
      "source": "app/src/main/java/com/deepseekharness/app/recovery/RecoveryRuntime.java",
      "method": "readAsset(name)/locations",
      "contract": "prepareRecoveryAssets writes exact pinned runtime map and archives outside standard assets; recovery APK gate validates mapped physical bytes.",
      "assets": [
        "recovery-agent.js",
        "recovery-profile.patch.yml",
        "recovery-profile-package.json",
        "recovery-runtime.json",
        "recovery-asset-locations.json"
      ]
    },
