<?xml version="1.0" encoding="utf-8"?>
<!-- 无障碍服务配置。
     不限定 packageNames：agent 的屏幕操作要能作用于任意应用（限定了就只能操作
     系统设置，等于没有这项能力）。隐私靠「按需拉取」保证 —— 服务自身不做任何
     持续记录：onAccessibilityEvent 里除了用户主动开启的配对码窗口，其余一律直接
     返回；读屏只在 agent 调用 /app/ui/dump 的那一刻发生，结果直接回给会话，
     普通截图按请求保存到应用私有截图目录；MCP 截图内存返回，不独立自动上传。
     canPerformGestures 是点按与滑动的前提，没有它就得依赖 ADB 或 Shizuku。
     canTakeScreenshot 是 /app/ui/screenshot 截屏的前提：不声明会被系统直接拒绝
     （errorCode=ERROR_TAKE_SCREENSHOT_*），声明后 Android 11+ 才能 takeScreenshot。 -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/accessibility_desc"
    android:notificationTimeout="100" />
