<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" android:orientation="vertical" android:paddingStart="@dimen/page_pad" android:paddingEnd="@dimen/page_pad" android:paddingTop="6dp" android:paddingBottom="@dimen/gap_control">
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingBottom="@dimen/gap_control">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_chip" android:fontFamily="monospace" android:paddingStart="@dimen/gap_control" android:paddingTop="7dp" android:paddingEnd="@dimen/gap_control" android:paddingBottom="7dp" android:text="@string/ui_m0178" android:ellipsize="end" android:maxLines="1" android:textColor="@color/text_secondary" android:textSize="@dimen/text_caption" android:gravity="center" android:includeFontPadding="false" android:minHeight="48dp" />
            <TextView android:id="@+id/term_ctrlc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_m0050" android:textColor="@color/text_muted" android:textSize="@dimen/text_caption" style="@style/Widget.DSHA.ToolbarAction" android:lineSpacingExtra="3dp" android:minHeight="48dp" />
            <TextView android:id="@+id/term_clear" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/gap_tight" android:text="@string/ui_m0164" android:textColor="@color/text_muted" android:textSize="@dimen/text_caption" style="@style/Widget.DSHA.ToolbarAction" android:lineSpacingExtra="3dp" android:minHeight="48dp" />
            <TextView android:id="@+id/term_pty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/gap_tight" android:text="@string/ui_terminal_pty" android:textColor="@color/text_muted" android:textSize="@dimen/text_caption" style="@style/Widget.DSHA.ToolbarAction" android:lineSpacingExtra="3dp" android:minHeight="48dp" />
        </LinearLayout>
    </HorizontalScrollView>
    <include layout="@layout/view_terminal_tabs" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/bg_preview" android:orientation="vertical">
        <ScrollView android:id="@+id/term_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
            <TextView android:id="@+id/term_output" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:padding="@dimen/card_pad" android:textColor="@color/text_secondary" android:textIsSelectable="true" android:textSize="14sp" android:lineSpacingExtra="3dp" />
        </ScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="@dimen/gap_tight">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:text="@string/ui_terminal_prompt" android:textColor="@color/ok" android:textSize="@dimen/text_caption" android:lineSpacingExtra="3dp" />
            <EditText android:id="@+id/term_input" android:minHeight="48dp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@android:color/transparent" android:fontFamily="monospace" android:hint="@string/ui_m0024" android:imeOptions="actionSend" android:inputType="text" android:maxLines="1" android:textColor="@color/text" android:textColorHint="@color/text_muted" android:textSize="@dimen/text_label" android:paddingTop="12dp" android:paddingBottom="12dp" android:contentDescription="@string/page_terminal_command" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>