<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/dshaSurface"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_pad"
    android:paddingEnd="@dimen/page_pad"
    android:paddingTop="6dp"
    android:paddingBottom="@dimen/gap_control">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/gap_control">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:fontFamily="monospace"
            android:paddingStart="@dimen/gap_control"
            android:paddingTop="7dp"
            android:paddingEnd="@dimen/gap_control"
            android:paddingBottom="7dp"
            android:text="Ubuntu · proot"
            android:textColor="?attr/dshaTextSecondary"
            android:textSize="@dimen/text_caption" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/term_ctrlc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="中止"
            android:textColor="?attr/dshaTextMuted"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:id="@+id/term_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_tight"
            android:padding="6dp"
            android:text="清理"
            android:textColor="?attr/dshaTextMuted"
            android:textSize="@dimen/text_caption" />

        <!-- 切回真 PTY 终端（vim / htop / tmux 要用那一套） -->
        <TextView
            android:id="@+id/term_pty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_tight"
            android:padding="6dp"
            android:text="PTY"
            android:textColor="?attr/dshaTextMuted"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_preview"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/term_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <TextView
                android:id="@+id/term_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="@dimen/card_pad"
                android:textColor="?attr/dshaTextSecondary"
                android:textIsSelectable="true"
                android:textSize="@dimen/text_caption" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/dshaCard"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/gap_tight">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="# "
                android:textColor="?attr/dshaOk"
                android:textSize="@dimen/text_caption" />

            <EditText
                android:id="@+id/term_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="monospace"
                android:hint="输入命令，回车执行"
                android:imeOptions="actionSend"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="?attr/dshaText"
                android:textColorHint="?attr/dshaTextMuted"
                android:textSize="@dimen/text_label" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
