<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/terminal_surface" android:orientation="vertical">
    <TextView android:id="@+id/term_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="6dp"
        android:textColor="@color/terminal_foreground" android:textSize="13sp"
        android:visibility="gone" android:textIsSelectable="true" />
    <!-- 目录、模式与新建在宿主中；保留旧ID供迁移夹具定位。 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:visibility="gone"
        android:importantForAccessibility="noHideDescendants">
        <TextView android:id="@+id/term_pty" android:layout_width="wrap_content"
            android:layout_height="48dp" android:text="@string/ui_terminal_pty" />
        <include layout="@layout/view_terminal_tabs" />
    </LinearLayout>
    <ScrollView android:id="@+id/term_scroll" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <TextView android:id="@+id/term_output" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:fontFamily="monospace" android:padding="2dp"
            android:textColor="@color/terminal_foreground" android:textIsSelectable="true"
            android:layoutDirection="ltr" android:textDirection="ltr" android:textSize="13sp" />
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="2dp"
        android:layoutDirection="ltr">
        <TextView android:layout_width="wrap_content" android:layout_height="48dp"
            android:gravity="center" android:fontFamily="monospace" android:text="@string/ui_terminal_prompt"
            android:textColor="@color/terminal_foreground" android:textSize="13sp" />
        <view class="com.deepseekharness.app.ui.TerminalFragment$CommandInput"
            android:id="@+id/term_input" android:minHeight="48dp" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:background="@android:color/transparent" android:fontFamily="monospace"
            android:hint="@string/ui_m0024" android:imeOptions="actionSend|flagNoExtractUi"
            android:inputType="textMultiLine|textNoSuggestions" android:maxLines="3"
            android:textColor="@color/terminal_foreground" android:textColorHint="@color/terminal_foreground"
            android:textDirection="ltr" android:textSize="13sp" />
        <TextView android:id="@+id/term_send" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minWidth="48dp" android:minHeight="48dp"
            android:gravity="center" android:paddingHorizontal="12dp" android:paddingVertical="8dp"
            android:textColor="@color/terminal_foreground" android:textSize="13sp"
            android:focusable="true" android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/term_ctrlc" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="144dp"
                android:gravity="center" android:paddingHorizontal="12dp" android:paddingVertical="8dp"
                android:text="@string/ui_m0050" android:textColor="@color/terminal_foreground"
                android:textSize="13sp" android:background="?android:attr/selectableItemBackground" />
            <TextView android:id="@+id/term_clear" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="96dp"
                android:gravity="center" android:paddingHorizontal="12dp" android:paddingVertical="8dp"
                android:text="@string/ui_m0164" android:textColor="@color/terminal_foreground"
                android:textSize="13sp" android:background="?android:attr/selectableItemBackground" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
