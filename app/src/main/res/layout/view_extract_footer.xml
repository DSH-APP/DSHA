<?xml version="1.0" encoding="utf-8"?>
<!-- 运行环境维护页与首次引导完成页共用的紧凑底栏（build249 方案 B，build255 状态配色）：
     主操作行（主按钮 / 进度面板 + 受限入口）+ 一行三个独立描边次要入口。
     竖屏主操作在上、受限入口在下；宽屏 / 横屏由 ExtractFooter 改为并排（次左主右）。
     维护进行中主按钮换成不可点的进度面板 extract_busy，避免“浅底白字”的禁用按钮看不清。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/extract_footer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_onb_footer"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/extract_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/extract_retry"
            style="@style/ShellPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/extract_primary_height" />

        <LinearLayout
            android:id="@+id/extract_busy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_extract_busy"
            android:gravity="center"
            android:importantForAccessibility="yes"
            android:minHeight="@dimen/extract_primary_height"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:indeterminateTint="@color/shell_accent" />

            <TextView
                android:id="@+id/extract_busy_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/shell_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/extract_busy_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/shell_text_secondary"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/extract_enter"
            style="@style/ShellSecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="@dimen/touch_min" />
    </LinearLayout>

    <!-- 次要入口（方案 B）：三个独立描边小按钮，间距 8dp；强调项换告警 / 提醒描边与浅底。 -->
    <LinearLayout
        android:id="@+id/extract_links"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/extract_logs"
            style="@style/ExtractLinkButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/extract_copy_support"
            style="@style/ExtractLinkButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/extract_emergency"
            style="@style/ExtractLinkButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
