    <com.deepseekharness.app.ui.miuix.MiuixPanel android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:id="@+id/pluginMarketCard" android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_from_link" android:textSize="16sp" android:textColor="@color/text" android:includeFontPadding="false" android:textStyle="bold" android:accessibilityHeading="true" android:lineSpacingExtra="3dp" />
