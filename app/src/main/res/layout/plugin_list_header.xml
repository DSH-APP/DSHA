                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_plugin_link" android:textSize="13sp" android:textColor="@color/text_secondary" android:includeFontPadding="false" android:layout_marginTop="16dp" android:lineSpacingExtra="3dp" />
