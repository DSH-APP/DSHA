            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnPluginWebsite" android:orientation="horizontal" android:minHeight="64dp" android:padding="13dp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:gravity="center_vertical">
                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_plugins" android:background="@drawable/bg_logo" android:padding="8dp" android:contentDescription="@null" app:tint="@color/primary" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="12dp">
