                    <TextView android:id="@+id/btnPluginInstall" style="@style/PluginAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="@dimen/gap_tight" android:text="@string/ui2_resolve" android:background="@drawable/bg_polished_primary" android:textColor="@color/polished_primary_text" android:minHeight="48dp" android:lineSpacingExtra="3dp" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" />
                </com.deepseekharness.app.ui.ActionRow>
            </LinearLayout>
        </LinearLayout>
    </com.deepseekharness.app.ui.miuix.MiuixPanel>
    <LinearLayout android:id="@+id/installedControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
