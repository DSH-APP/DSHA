<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_card" android:padding="4dp" android:layout_marginBottom="14dp" android:gravity="center_vertical">
      <TextView android:id="@+id/btnMarket" style="@style/PluginAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:background="@drawable/bg_plugin_segment" android:text="@string/ui_m0133" android:minHeight="48dp" android:layout_marginStart="0dp" android:textSize="13sp" />
      <TextView android:id="@+id/btnInstalled" style="@style/PluginAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="0dp" android:background="@drawable/bg_plugin_segment" android:text="@string/ui_m0135" android:minHeight="48dp" android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/pluginMarketCard" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginBottom="14dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/pluginLinkSection" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_input" android:minHeight="48dp" android:paddingStart="4dp" android:addStatesFromChildren="true">
            <EditText android:id="@+id/appbar_github_input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:background="@null" android:hint="@string/ui2_plugin_link_hint" android:inputType="textUri" android:imeOptions="actionGo" android:singleLine="true" android:importantForAutofill="no" android:paddingStart="12dp" android:paddingEnd="8dp" android:textColor="@color/text" android:textColorHint="@color/text_muted" android:textSize="13sp" android:gravity="center_vertical" />
            <View android:layout_width="1dp" android:layout_height="16dp" android:background="@color/line" />
            <TextView android:id="@+id/btnPluginPaste" style="@style/Widget.DSHA.ToolbarAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui2_paste" android:textColor="@color/primary" android:textStyle="bold" android:minHeight="48dp" android:minWidth="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" />
          </LinearLayout>
          <TextView android:id="@+id/btnPluginInstall" style="@style/PluginAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/ui2_install" android:background="@drawable/bg_btn_primary" android:textColor="@color/button_primary_text" android:minHeight="48dp" android:minWidth="72dp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/pluginLinkHint" style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_tight" />
      </LinearLayout>
      <TextView android:id="@+id/btnPluginDownloadSource" style="@style/Widget.DSHA.ToolbarAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:gravity="start|center_vertical" android:paddingStart="0dp" android:paddingEnd="0dp" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_marginTop="4dp" android:clickable="true" android:focusable="true" />
      <TextView android:id="@+id/pluginDownloadHint" style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:visibility="gone" />
      <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:id="@+id/pluginWebsiteSection" android:orientation="vertical">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnPluginWebsite" android:orientation="horizontal" android:minHeight="44dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:gravity="center_vertical">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_plugins" android:contentDescription="@null" app:tint="@color/text_secondary" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui2_community_entry" android:textSize="13sp" android:textColor="@color/text" android:includeFontPadding="false" android:layout_marginStart="8dp" android:singleLine="true" android:ellipsize="end" />
          </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:orientation="horizontal" android:id="@+id/pluginLocalCard" android:gravity="center_vertical">
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:id="@+id/btnImport" android:orientation="horizontal" android:minHeight="44dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:gravity="center">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_ui_import" android:contentDescription="@null" app:tint="@color/text_secondary" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui2_import_zip" android:textSize="13sp" android:textColor="@color/text" android:includeFontPadding="false" android:layout_marginStart="8dp" android:singleLine="true" android:ellipsize="end" />
          </LinearLayout>
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:id="@+id/btnExport" android:orientation="horizontal" android:minHeight="44dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:gravity="center">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_ui_export" android:contentDescription="@null" app:tint="@color/text_secondary" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui2_export_short" android:textSize="13sp" android:textColor="@color/text" android:includeFontPadding="false" android:layout_marginStart="8dp" android:singleLine="true" android:ellipsize="end" />
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_local_plugins" android:textSize="11sp" android:textColor="@color/text_muted" android:includeFontPadding="false" android:textStyle="bold" android:visibility="gone" android:id="@+id/pluginLocalTitle" />
    </LinearLayout>
    <LinearLayout android:id="@+id/installedControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui2_installed" android:textSize="14sp" android:textColor="@color/text" android:includeFontPadding="false" android:textStyle="bold" android:layout_weight="1" />
        <TextView android:id="@+id/pluginCount" style="@style/DshaText.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" />
        <TextView android:id="@+id/btnRefresh" style="@style/PluginAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="44dp" android:minHeight="44dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:drawableStart="@drawable/ic_plugin_scan" android:drawablePadding="6dp" android:background="@drawable/bg_action_plain" android:text="@string/ui_m0159" android:singleLine="true" android:textColor="@color/primary" android:contentDescription="@string/ui_m0158" />
      </LinearLayout>
      <EditText android:id="@+id/pluginSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:background="@drawable/bg_input" android:hint="@string/ui_m0138" android:singleLine="true" android:imeOptions="actionDone" android:inputType="text" android:padding="@dimen/gap_control" android:textColor="@color/text" android:textColorHint="@color/text_muted" android:textSize="13sp" android:layout_marginTop="12dp" android:drawableStart="@drawable/ic_ui_search" android:drawablePadding="12dp" />
      <CheckBox android:id="@+id/chkHideBuiltin" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:layout_marginTop="@dimen/gap_hair" android:text="@string/ui_m0081" android:buttonTint="@color/primary" android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="4dp" android:baselineAligned="false" android:layout_marginBottom="@dimen/gap_control">
        <Button android:id="@+id/btnSort" style="@style/Widget.DSHA.TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="44dp" android:text="@string/plugin_sort_az" android:textSize="13sp" android:paddingStart="8dp" android:paddingEnd="8dp" android:drawableEnd="@drawable/ic_ui_chevron" android:drawablePadding="4dp" />
        <Button android:id="@+id/btnPluginUpdates" style="@style/Widget.DSHA.TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="44dp" android:layout_marginStart="8dp" android:text="@string/ui_m0018" android:textSize="13sp" android:paddingStart="8dp" android:paddingEnd="8dp" android:textColor="@color/action_text" />
      </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/pluginBusy" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="@dimen/gap_control" android:indeterminate="true" android:indeterminateTint="@color/primary" android:visibility="gone" />
    <TextView android:id="@+id/statusText" style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" android:maxLines="2" android:ellipsize="end" android:minHeight="44dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="@dimen/gap_hair" android:paddingBottom="@dimen/gap_hair" android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_m0134" android:gravity="center_vertical" />
    <Button android:id="@+id/btnCancelPluginTask" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:text="@string/ui_m0079" />

</LinearLayout>
