            <TextView android:id="@+id/btnInstalled" style="@style/PluginAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="0dp" android:background="@drawable/bg_plugin_segment" android:text="@string/ui_m0135" android:minHeight="48dp" android:textSize="13sp" android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </com.deepseekharness.app.ui.miuix.MiuixPanel>
    <com.deepseekharness.app.ui.miuix.MiuixPanel android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
