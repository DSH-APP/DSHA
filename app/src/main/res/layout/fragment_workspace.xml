<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/dshaSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_pad">
        <com.deepseekharness.app.GlassCard
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_block"
            android:background="@drawable/bg_card"
            android:orientation="vertical">
        <TextView
            android:id="@+id/sub_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/gap_tight"
            android:text="‹ 返回"
            android:textColor="?attr/dshaTextSecondary"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="工作区管理"
            android:textSize="@dimen/text_display"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:text="工作区目录名（rootfs 内）" />

        <EditText
            android:id="@+id/workspace_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="deepseek-harness" />

        <Button android:background="@drawable/bg_btn" android:textAllCaps="false"
            android:id="@+id/workspace_apply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_control"
            android:text="应用路径" />

        </com.deepseekharness.app.GlassCard>

        <com.deepseekharness.app.GlassCard
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_block"
            android:background="@drawable/bg_card"
            android:orientation="vertical">
        <TextView
            android:id="@+id/workspace_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:lineSpacingExtra="4dp"
            android:textSize="@dimen/text_body" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:text="文件共享（MT 注入文件提供器 · 无需 ROOT）"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/workspace_share_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight"
            android:lineSpacingExtra="3dp"
            android:text="尚未加载"
            android:textSize="@dimen/text_label" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:text="设备 Shell 能力（Shizuku）"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/workspace_shizuku_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight"
            android:text="Shizuku 未授权"
            android:textSize="@dimen/text_label" />

        <Button android:background="@drawable/bg_btn" android:textAllCaps="false"
            android:id="@+id/workspace_shizuku_auth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_control"
            android:text="授权 Shizuku" />

        </com.deepseekharness.app.GlassCard>

        <com.deepseekharness.app.GlassCard
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_block"
            android:background="@drawable/bg_card"
            android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight"
            android:lineSpacingExtra="3dp"
            android:text="授权后，助手（Web UI 里的 agent）可在设备上执行 shell 命令：\ncurl http://127.0.0.1:3090/exec?cmd=..."
            android:textSize="@dimen/text_caption" />

        <Button android:background="@drawable/bg_btn" android:textAllCaps="false"
            android:id="@+id/workspace_backup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_control"
            android:text="备份全部数据（导出到外部存储）" />

        <Button android:background="@drawable/bg_btn" android:textAllCaps="false"
            android:id="@+id/workspace_restore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight"
            android:text="从备份恢复（选择备份文件）" />

        <Button android:background="@drawable/bg_btn" android:textAllCaps="false"
            android:id="@+id/workspace_clean_sessions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight"
            android:text="清理损坏会话（隔离到 corrupt-backup，可恢复）" />

        <Button android:background="@drawable/bg_btn" android:textAllCaps="false"
            android:id="@+id/workspace_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight"
            android:text="重置配置（保留对话记录）" />

        <Button android:background="@drawable/bg_btn_danger" android:textAllCaps="false"
            android:id="@+id/workspace_clear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:text="清除环境" />
        </com.deepseekharness.app.GlassCard>

    </LinearLayout>
</ScrollView>
