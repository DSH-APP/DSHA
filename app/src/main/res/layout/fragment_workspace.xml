<?xml version="1.0" encoding="utf-8"?>
<!--
  数据与备份首页（2026-11 重构）：状态卡 + 三组入口。
  状态卡文案、配色与可用性全部由 WorkspaceFragment 按 BackupHealth 渲染；本文件只放骨架。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/shell_bg">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/shell_page_pad" android:paddingEnd="@dimen/shell_page_pad" android:paddingTop="@dimen/shell_page_top" android:paddingBottom="@dimen/shell_page_bottom">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
      <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:layout_marginEnd="14dp" android:background="@drawable/bg_launch_tile" android:importantForAccessibility="no"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_ui2_folder" app:tint="@color/shell_accent" /></FrameLayout>
      <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/ui2_data_title" android:textSize="26sp" android:textColor="@color/text" android:includeFontPadding="false" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_data_sub" android:textSize="13sp" android:textColor="@color/text_secondary" android:includeFontPadding="false" android:layout_marginTop="6dp" />

    <!-- ========== 状态卡 ========== -->
    <LinearLayout android:id="@+id/workspace_hero" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical" android:background="@drawable/bg_shell_card" android:padding="18dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="top">
        <FrameLayout android:id="@+id/workspace_hero_tile" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_data_status_tile" android:importantForAccessibility="no">
          <ImageView android:id="@+id/workspace_hero_icon" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_recovery_shield" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
          <TextView android:id="@+id/workspace_hero_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="@color/shell_text" android:textStyle="bold" android:includeFontPadding="false" android:accessibilityHeading="true" />
          <!-- 保留旧 id：布局预览与语言审计按它识别「历史 / 运行状态」文字。 -->
          <TextView android:id="@+id/workspace_backup_status" style="@style/ShellCardBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textIsSelectable="true" />
        </LinearLayout>
      </LinearLayout>
      <ProgressBar android:id="@+id/workspace_hero_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:indeterminate="true" android:indeterminateTint="@color/shell_accent" android:visibility="gone" />
      <LinearLayout android:id="@+id/workspace_stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/workspace_stat_manual" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/bg_data_stat" android:clickable="true" android:focusable="true" android:minHeight="@dimen/touch_min" android:padding="12dp">
          <TextView android:id="@+id/workspace_stat_manual_label" style="@style/ShellRowSub" android:layout_width="match_parent" android:layout_height="wrap_content" />
          <TextView android:id="@+id/workspace_stat_manual_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="14sp" android:textColor="@color/shell_text" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/workspace_stat_auto" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical" android:background="@drawable/bg_data_stat" android:clickable="true" android:focusable="true" android:minHeight="@dimen/touch_min" android:padding="12dp">
          <TextView android:id="@+id/workspace_stat_auto_label" style="@style/ShellRowSub" android:layout_width="match_parent" android:layout_height="wrap_content" />
          <TextView android:id="@+id/workspace_stat_auto_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="14sp" android:textColor="@color/shell_text" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/workspace_stat_place" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical" android:background="@drawable/bg_data_stat" android:minHeight="@dimen/touch_min" android:padding="12dp">
          <TextView android:id="@+id/workspace_stat_place_label" style="@style/ShellRowSub" android:layout_width="match_parent" android:layout_height="wrap_content" />
          <TextView android:id="@+id/workspace_stat_place_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="14sp" android:textColor="@color/shell_text" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:id="@+id/workspace_hero_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
        <!-- 旧 id 保留：一键备份主操作。 -->
        <Button android:id="@+id/workspace_backup" style="@style/ShellPrimaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <Button android:id="@+id/workspace_restore" style="@style/ShellSecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:minHeight="@dimen/shell_button_height" />
      </LinearLayout>
      <!-- 旧 id 保留：运行中才显示的「取消备份」。 -->
      <Button android:id="@android:id/button2" style="@style/ShellDangerButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:visibility="gone" />
    </LinearLayout>

    <!-- ========== 备份选项 ========== -->
    <TextView android:id="@+id/workspace_section_backup" android:drawableStart="@drawable/ic_section_data" style="@style/ShellSectionIconLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:layout_marginBottom="8dp" android:accessibilityHeading="true" />
    <LinearLayout style="@style/ShellGroup" android:layout_width="match_parent" android:layout_height="wrap_content">
      <include android:id="@+id/workspace_auto" layout="@layout/item_data_entry" />
      <View style="@style/ShellDivider" />
      <include android:id="@+id/workspace_export" layout="@layout/item_data_entry" />
      <View style="@style/ShellDivider" />
      <include android:id="@+id/workspace_history" layout="@layout/item_data_entry" />
    </LinearLayout>

    <!-- ========== 存储与文件 ========== -->
    <TextView android:id="@+id/workspace_section_files" android:drawableStart="@drawable/ic_ui2_folder" style="@style/ShellSectionIconLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:layout_marginBottom="8dp" android:accessibilityHeading="true" />
    <LinearLayout style="@style/ShellGroup" android:layout_width="match_parent" android:layout_height="wrap_content">
      <include android:id="@+id/workspace_storage" layout="@layout/item_data_entry" />
      <View style="@style/ShellDivider" />
      <include android:id="@+id/workspace_files" layout="@layout/item_data_entry" />
      <View style="@style/ShellDivider" />
      <include android:id="@+id/workspace_skills" layout="@layout/item_data_entry" />
    </LinearLayout>

    <!-- ========== 维护与恢复 ========== -->
    <TextView android:drawableStart="@drawable/ic_section_maintenance" style="@style/ShellSectionIconLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_maintenance" android:layout_marginTop="22dp" android:layout_marginBottom="8dp" android:accessibilityHeading="true" />
    <LinearLayout style="@style/ShellGroup" android:layout_width="match_parent" android:layout_height="wrap_content">
      <include android:id="@+id/workspace_guide" layout="@layout/item_data_entry" />
      <View style="@style/ShellDivider" />
      <include android:id="@+id/workspace_retained" layout="@layout/item_data_entry" />
      <View style="@style/ShellDivider" />
      <include android:id="@+id/workspace_location" layout="@layout/item_data_entry" />
      <View style="@style/ShellDivider" />
      <include android:id="@+id/workspace_reset" layout="@layout/item_data_entry" />
    </LinearLayout>
  </LinearLayout>
</ScrollView>
