<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/page_pad">
        <TextView android:id="@+id/install_status" style="@style/DshaText.Label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight" />
        <Button android:id="@+id/install_btn" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:layout_marginTop="@dimen/gap_control" android:background="@drawable/bg_btn_primary"
            android:textColor="@color/button_primary_text" android:text="仅检查环境" />
        <Button android:id="@+id/install_repair" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_tight"
            android:background="@drawable/bg_btn" android:text="检查并按需修复" />
        <Button android:id="@+id/install_cancel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_tight"
            android:background="@drawable/bg_btn" android:text="取消检查" android:visibility="gone" />
        <ProgressBar android:id="@+id/install_progressbar" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="@dimen/progress_bold"
            android:layout_marginTop="@dimen/gap_control" android:indeterminateTint="@color/primary"
            android:visibility="gone" />
        <TextView android:id="@+id/install_progress" style="@style/DshaText.Label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight" android:visibility="gone" />
        <Button android:id="@+id/install_step1" style="@style/InstallStep"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight" android:text="1 · Linux 环境（rootfs）" />
        <Button android:id="@+id/install_step2" style="@style/InstallStep"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight" android:text="2 · 基础工具\n补齐 curl / git / Python" />
        <Button android:id="@+id/install_step3" style="@style/InstallStep"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight" android:text="3 · Node.js" />
        <Button android:id="@+id/install_step4" style="@style/InstallStep"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight" android:text="4 · pnpm 包管理器" />
        <Button android:id="@+id/install_step5" style="@style/InstallStep"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight" android:text="5 · deepseek-harness" />
        <Button android:id="@+id/install_step6" style="@style/InstallStep"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight" android:text="6 · 运行补丁" />
        <TextView android:id="@+id/install_steps" style="@style/DshaText.Body"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_block" android:textIsSelectable="true" />
        <TextView android:id="@+id/install_error" style="@style/DshaText.Label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_control" android:background="@drawable/bg_card"
            android:padding="@dimen/card_pad" android:textColor="@color/err"
            android:textIsSelectable="true" android:visibility="gone" />
        <Button android:id="@+id/install_copy" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_tight"
            android:background="@drawable/bg_btn" android:text="复制脱敏日志" android:visibility="gone" />
        <TextView style="@style/DshaText.Label" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_control"
            android:text="详细输出" />
        <ScrollView android:id="@+id/install_log_scroll" android:layout_width="match_parent"
            android:layout_height="220dp" android:layout_marginTop="@dimen/gap_tight"
            android:background="@drawable/bg_card" android:fillViewport="true">
            <TextView android:id="@+id/install_log" style="@style/DshaText.Caption"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="@dimen/card_pad" android:fontFamily="monospace" android:textIsSelectable="true" />
        </ScrollView>
        <Button android:id="@+id/install_crash" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="查看崩溃日志" android:visibility="gone" />
        <TextView style="@style/DshaText.Caption" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_block"
            android:text="仅检查不会安装组件。按需修复只处理失败项，curl / git 缺失时会联网下载。切页或旋转后任务继续，返回可查看进度和结果；修复期间的停止请求会等待安全点。" />
        <Button android:id="@+id/install_uninstall" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_section"
            android:background="@drawable/bg_btn_danger" android:text="备份并重建环境" android:textColor="@color/button_danger_text" />
    </LinearLayout>
</ScrollView>
