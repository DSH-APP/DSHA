<?xml version="1.0" encoding="utf-8"?>
<!--
  插件卡片警示胶囊：重启待办等短提示，与普通提示条分开呈现。
  底色、图标色与文字色由 PluginFragment 按语义语气 tint，布局不写死颜色。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_plugin_badge" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="9dp" android:paddingTop="5dp" android:paddingEnd="11dp" android:paddingBottom="5dp">

    <ImageView android:id="@+id/pluginChipIcon" android:layout_width="14dp" android:layout_height="14dp" android:contentDescription="@null" android:importantForAccessibility="no" app:tint="@color/shell_warn" />

    <TextView android:id="@+id/pluginChipText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:includeFontPadding="false" android:maxLines="3" android:textColor="@color/shell_warn" android:textSize="12sp" android:textStyle="bold" />
</LinearLayout>
