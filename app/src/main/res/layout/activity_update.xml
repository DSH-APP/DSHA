<?xml version="1.0" encoding="utf-8"?>
<!--
  版本更新（压缩版，手机 / 平板竖屏）：工具栏标题 → 主卡（版本 / 通道 / 状态 / 进度按钮）→ 候选卡 → 管理。
  去掉重复的大标题与介绍；平板竖屏由 UpdateActivity 把 update_content 收成居中约 640dp 的单列。
  平板横屏（≥ 840dp）见 layout-w840dp/activity_update.xml，共用 update_hero / update_manage 与全部 id。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/shell_bg" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="@dimen/shell_header_min_height" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="16dp">
    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/update_back" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/ui_m0201" android:padding="12dp" android:src="@drawable/ic_ui_back" app:tint="@color/shell_text" />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:accessibilityHeading="true" android:includeFontPadding="false" android:text="@string/ui2_updates" android:textColor="@color/shell_text" android:textSize="@dimen/shell_title_text" android:textStyle="bold" />
  </LinearLayout>
  <ScrollView android:id="@+id/update_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:fillViewport="true">
    <LinearLayout android:id="@+id/update_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/shell_page_pad" android:paddingTop="4dp" android:paddingEnd="@dimen/shell_page_pad" android:paddingBottom="@dimen/shell_page_bottom">
      <include layout="@layout/update_hero" />
      <include layout="@layout/update_candidate" />
      <TextView style="@style/ShellSectionLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/shell_section_gap" android:layout_marginBottom="@dimen/shell_section_margin" android:accessibilityHeading="true" android:text="@string/ui2_management" />
      <include layout="@layout/update_manage" />
    </LinearLayout>
  </ScrollView>
</LinearLayout>
