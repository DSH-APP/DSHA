<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/card_pad">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/net_port"
                android:text="@string/ui2_port_preferred"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:includeFontPadding="false" />
            <EditText
                android:id="@+id/net_port"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="@dimen/gap_tight"
                android:background="@drawable/bg_input"
                android:importantForAutofill="no"
                android:inputType="number"
                android:paddingStart="@dimen/gap_control"
                android:paddingEnd="@dimen/gap_control" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui2_port_hint"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:includeFontPadding="false"
                android:layout_marginTop="6dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui2_dns"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:includeFontPadding="false"
                android:layout_marginTop="14dp" />
            <com.deepseekharness.app.ui.DshaSelectView
                android:id="@+id/net_dns_choice"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/net_lan"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingStart="@dimen/gap_tight"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/ui_m0063"
                android:textSize="13sp" />
            <TextView
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ui_lan_unencrypted"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
        <Button
            android:id="@+id/net_save"
            style="@style/Widget.DSHA.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="16dp"
            android:text="@string/ui_m0002" />
    </LinearLayout>
</ScrollView>
