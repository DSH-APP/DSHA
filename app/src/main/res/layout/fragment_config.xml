<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" android:clipToPadding="false">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/page_pad" android:paddingTop="@dimen/gap_control" android:paddingEnd="@dimen/page_pad" android:paddingBottom="@dimen/gap_section">
            <LinearLayout style="@style/DshaCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp">
                <TextView style="@style/DshaText.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/api_credentials" />
                <TextView style="@style/DshaText.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_control" android:text="@string/deepseek_api_key" />
                <TextView style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_hair" android:text="@string/ui_m0082" />
                <EditText android:id="@+id/config_api_key" style="@style/DshaText.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="@dimen/gap_tight" android:background="@drawable/bg_input" android:hint="sk-..." android:importantForAutofill="no" android:inputType="textPassword" android:paddingStart="@dimen/gap_control" android:paddingEnd="@dimen/gap_control" />
                <TextView android:id="@+id/config_adv_header" style="@style/DshaText.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_control" android:background="?attr/selectableItemBackground" android:paddingTop="@dimen/gap_tight" android:paddingBottom="@dimen/gap_tight" android:text="@string/ui_m0043" />
                <LinearLayout android:id="@+id/config_adv_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView style="@style/DshaText.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_tight" android:text="@string/ui_m0175" />
                    <EditText android:id="@+id/config_port" style="@style/DshaText.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="@dimen/gap_tight" android:background="@drawable/bg_input" android:hint="@string/ui_m0028" android:importantForAutofill="no" android:inputType="number" android:paddingStart="@dimen/gap_control" android:paddingEnd="@dimen/gap_control" />
                    <TextView style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/web_port_fallback_hint" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout style="@style/DshaCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_control">
                <TextView style="@style/DshaText.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_m0143" />
                <CheckBox android:id="@+id/config_check_update" style="@style/DshaText.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_min" android:paddingStart="@dimen/gap_tight" android:text="@string/ui_m0089" />
                <TextView style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginBottom="8dp" android:text="@string/ui_m0204" />
                <CheckBox android:id="@+id/config_picture_in_picture" style="@style/DshaText.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_min" android:paddingStart="@dimen/gap_tight" android:text="@string/picture_in_picture_title" />
                <TextView android:id="@+id/config_picture_in_picture_hint" style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginBottom="8dp" android:text="@string/picture_in_picture_hint" />
                <CheckBox android:id="@+id/config_desktop_mode" style="@style/DshaText.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_min" android:paddingStart="@dimen/gap_tight" android:text="@string/ui_m0057" />
                <TextView style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginBottom="8dp" android:text="@string/ui_m0186" />
                <TextView style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="@dimen/gap_tight" android:gravity="center_vertical" android:text="@string/browser_description" />
                <CheckBox android:id="@+id/config_gecko_core" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:visibility="gone" android:text="@string/ui_m0055" android:textColor="@color/text_secondary" android:buttonTint="@color/primary" />
                <TextView android:id="@+id/config_gecko_hint" style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginBottom="8dp" android:text="@string/ui_m0118" />
                <CheckBox android:id="@+id/config_proroot" style="@style/DshaText.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_min" android:paddingStart="@dimen/gap_tight" android:text="@string/ui_m0054" />
                <TextView style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginBottom="8dp" android:text="@string/ui_m0111" />
                <CheckBox android:id="@+id/config_lan_mode" style="@style/DshaText.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_min" android:paddingStart="@dimen/gap_tight" android:text="@string/ui_m0063" />
                <TextView style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginBottom="8dp" android:text="@string/ui_m0093" />
                <CheckBox android:id="@+id/config_overlay_stream" style="@style/DshaText.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_min" android:paddingStart="@dimen/gap_tight" android:text="@string/ui_m0121" />
                <TextView style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginBottom="8dp" android:text="@string/ui_m0129" />
                <TextView android:id="@+id/config_overlay_style" style="@style/DshaText.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_min" android:background="@drawable/bg_chip_clickable" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="@dimen/gap_tight" android:paddingEnd="@dimen/gap_tight" android:text="@string/ui_m0122" android:includeFontPadding="false" />
                <TextView style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginBottom="8dp" android:text="@string/ui_m0194" />
                <CheckBox android:id="@+id/config_rc6" style="@style/DshaText.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_min" android:paddingStart="@dimen/gap_tight" android:text="@string/ui_m0040" android:visibility="gone" />
            </LinearLayout>

            <TextView android:id="@+id/config_workspace_entry" style="@style/Widget.DSHA.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="@dimen/gap_control" android:background="@drawable/bg_action_plain" android:gravity="center" android:text="@string/ui_m0126" />
            <LinearLayout style="@style/DshaCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
                <TextView style="@style/DshaText.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dns_title" />
                <RadioGroup android:id="@+id/config_dns_mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical">
                    <RadioButton android:id="@+id/dns_auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="@string/dns_auto" />
                    <RadioButton android:id="@+id/dns_ipv4" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="@string/dns_ipv4" />
                    <RadioButton android:id="@+id/dns_native" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="@string/dns_native" />
                </RadioGroup>
                <TextView style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/dns_hint" />
            </LinearLayout>
            <TextView android:id="@+id/config_repo_link" style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_section" android:gravity="center" android:text="DSHA" />
        </LinearLayout>
    </ScrollView>
    <Button android:id="@+id/config_save" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:layout_marginStart="@dimen/page_pad" android:layout_marginEnd="@dimen/page_pad" android:background="@drawable/bg_btn_primary" android:text="@string/ui_m0002" android:textAllCaps="false" android:textColor="@color/button_primary_text" android:textSize="@dimen/text_body" android:minHeight="@dimen/btn_height" />
</LinearLayout>
