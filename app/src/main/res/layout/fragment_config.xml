<?xml version="1.0" encoding="utf-8"?>
<!-- 配置页。分组原则：按「用户找东西时怎么想」排，不按代码演进顺序堆。
     · 需要按「保存配置」才生效的项全部排在保存按钮**之前**；按钮之后只放即时生效的操作，
       这样不会再有「ADB 那些设置改完要不要保存」的困惑。
     · 开关标签只留短名字，解释下沉成小字副标题 —— 原先每条都是「名称（一长串括号说明）」，
       在手机窄屏上每行折成两三行，扫读时就是一堵字墙。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/dshaSurface"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_pad">

        <TextView
            android:id="@+id/sub_back"
            style="@style/DshaText.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:text="‹ 返回" />

        <TextView
            style="@style/DshaText.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_tight"
            android:text="配置" />

            <TextView
                android:id="@+id/config_workspace_entry"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:background="@drawable/bg_chip_clickable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/gap_tight"
                android:paddingEnd="@dimen/gap_tight"
                android:text="📁 工作区 · 备份/恢复 · 环境管理" />

        <TextView
            style="@style/DshaText.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:text="连接" />
        <TextView
            style="@style/DshaText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_hair"
            android:layout_marginBottom="@dimen/gap_tight"
            android:textColor="?attr/dshaTextSecondary"
            android:text="改完这一节要按下面的「保存配置」" />

        <LinearLayout
            style="@style/DshaCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/DshaText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:text="DeepSeek API Key" />
            <EditText
                android:id="@+id/config_api_key"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/gap_hair"
                android:background="@drawable/bg_input"
                android:paddingStart="@dimen/gap_tight"
                android:paddingEnd="@dimen/gap_tight"
                android:textSize="@dimen/text_body"
                android:inputType="textNoSuggestions"
                android:hint="sk-..." />

            <TextView
                android:id="@+id/config_adv_header"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:background="@drawable/bg_chip_clickable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/gap_tight"
                android:paddingEnd="@dimen/gap_tight"
                android:text="▸ 高级：端口" />

            <LinearLayout
                android:id="@+id/config_adv_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <TextView
                style="@style/DshaText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:text="WebUI 端口" />
            <EditText
                android:id="@+id/config_port"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/gap_hair"
                android:background="@drawable/bg_input"
                android:paddingStart="@dimen/gap_tight"
                android:paddingEnd="@dimen/gap_tight"
                android:textSize="@dimen/text_body"
                android:inputType="number"
                android:hint="3080" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            style="@style/DshaText.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:text="安全" />

        <LinearLayout
            style="@style/DshaCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/config_confirm_shell"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:text="危险操作需要确认" />
            <TextView
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_control"
                android:layout_marginBottom="@dimen/gap_tight"
                android:textColor="?attr/dshaTextSecondary"
                android:text="删除、格式化、卸载、重启这类命令会先弹窗问你" />

            <TextView
                android:id="@+id/config_guard_status"
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/gap_tight"
                android:textColor="?attr/dshaTextSecondary"
                android:text="" />

            <CheckBox
                android:id="@+id/config_root_shell"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:text="允许 root shell" />
            <TextView
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_control"
                android:layout_marginBottom="@dimen/gap_tight"
                android:textColor="?attr/dshaTextSecondary"
                android:text="agent 可以用 --su 提权。默认关，开了等于把整台机器交出去" />

            <CheckBox
                android:id="@+id/config_backup_key"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:text="备份里包含 API Key" />
            <TextView
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_control"
                android:layout_marginBottom="@dimen/gap_tight"
                android:textColor="?attr/dshaTextSecondary"
                android:text="关掉更安全，代价是恢复到新设备后要重新填一次" />

            <CheckBox
                android:id="@+id/config_cap_location"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:text="允许读取位置" />
            <TextView
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_control"
                android:layout_marginBottom="@dimen/gap_tight"
                android:textColor="?attr/dshaTextSecondary"
                android:text="能定位到你本人，默认关闭" />

            <CheckBox
                android:id="@+id/config_cap_sensors"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:text="允许读传感器、开手电" />
            <TextView
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_control"
                android:layout_marginBottom="@dimen/gap_tight"
                android:textColor="?attr/dshaTextSecondary"
                android:text="环境光 / 加速度 / 磁力这些，没有隐私风险" />

        </LinearLayout>

        <TextView
            style="@style/DshaText.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:text="运行时" />

        <LinearLayout
            style="@style/DshaCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/config_proroot"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:text="proroot 运行时" />
            <TextView
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_control"
                android:layout_marginBottom="@dimen/gap_tight"
                android:textColor="?attr/dshaTextSecondary"
                android:text="默认开启，启动快 5~6 倍。关掉则退回传统 proot" />

            <CheckBox
                android:id="@+id/config_gecko_core"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:text="内置浏览器内核" />
            <TextView
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_control"
                android:layout_marginBottom="@dimen/gap_tight"
                android:textColor="?attr/dshaTextSecondary"
                android:text="系统 WebView 过旧时再开，更吃内存" />

            <CheckBox
                android:id="@+id/config_rc6"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:text="deepseek-harness 用最新 RC" />

            <TextView
                style="@style/DshaText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:text="自动备份（每启动 N 次备份一次，0 = 关闭）" />
            <EditText
                android:id="@+id/config_auto_backup"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/gap_hair"
                android:background="@drawable/bg_input"
                android:paddingStart="@dimen/gap_tight"
                android:paddingEnd="@dimen/gap_tight"
                android:textSize="@dimen/text_body"
                android:inputType="number"
                android:text="5"
                android:hint="5" />

        </LinearLayout>

        <TextView
            style="@style/DshaText.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:text="显示与交互" />

        <LinearLayout
            style="@style/DshaCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/config_ui_theme"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_clickable"
                android:minHeight="@dimen/touch_min"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/gap_control"
                android:paddingEnd="@dimen/gap_control"
                android:text="🎨 外观 · 配色与材质" />

            <TextView
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_control"
                android:layout_marginBottom="@dimen/gap_tight"
                android:textColor="?attr/dshaTextSecondary"
                android:text="默认蓝灰 · 樱花浅粉 · 玻璃深色半透明。切换后界面立即重建。" />

            <CheckBox
                android:id="@+id/config_overlay_stream"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:text="屏幕顶部流式显示 AI 输出" />
            <TextView
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_control"
                android:layout_marginBottom="@dimen/gap_tight"
                android:textColor="?attr/dshaTextSecondary"
                android:text="需要悬浮窗权限。内容旁人看得见，注意场合" />

            <TextView
                android:id="@+id/config_overlay_style"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:background="@drawable/bg_chip_clickable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/gap_tight"
                android:paddingEnd="@dimen/gap_tight"
                android:text="悬浮条外观与行为 ▸ 底色 / 透明度 / 行数 / 停留 / 思考过程 / 就地批准" />

            <CheckBox
                android:id="@+id/config_desktop_mode"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:text="电脑模式" />
            <TextView
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_control"
                android:layout_marginBottom="@dimen/gap_tight"
                android:textColor="?attr/dshaTextSecondary"
                android:text="预览时用桌面浏览器标识" />

        </LinearLayout>

        <TextView
            style="@style/DshaText.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:text="网络" />

        <LinearLayout
            style="@style/DshaCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/config_lan_mode"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:text="局域网访问" />
            <TextView
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_control"
                android:layout_marginBottom="@dimen/gap_tight"
                android:textColor="?attr/dshaTextSecondary"
                android:text="同网段的设备都能打开你的 WebUI，注意安全" />

        </LinearLayout>

        <Button
            android:id="@+id/config_save"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/gap_section"
            android:background="@drawable/bg_btn"
            android:textSize="@dimen/text_body"
            android:text="保存配置" />

        <TextView
            style="@style/DshaText.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:text="设备与权限" />
        <TextView
            style="@style/DshaText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_hair"
            android:layout_marginBottom="@dimen/gap_tight"
            android:textColor="?attr/dshaTextSecondary"
            android:text="下面这些点一下就生效，不用保存" />

        <LinearLayout
            style="@style/DshaCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/config_adb_enable"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:text="启用 ADB 设备通道" />
            <TextView
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_control"
                android:layout_marginBottom="@dimen/gap_tight"
                android:textColor="?attr/dshaTextSecondary"
                android:text="默认关闭。开了 agent 才能用 ADB 操作手机" />

            <TextView
                android:id="@+id/config_adb_status"
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/gap_tight"
                android:textColor="?attr/dshaTextSecondary"
                android:text="ADB 已关闭。不用无线调试就保持关闭。" />

            <Button
                android:id="@+id/config_adb_pair"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="@dimen/gap_tight"
                android:background="@drawable/bg_btn"
                android:textSize="@dimen/text_body"
                android:text="🔐 ADB 无线配对（免 Shizuku）" />

            <Button
                android:id="@+id/config_a11y"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="@dimen/gap_tight"
                android:background="@drawable/bg_btn"
                android:textSize="@dimen/text_body"
                android:text="👆 屏幕操作权限（免 ADB 让 AI 操作手机）" />

            <TextView
                android:id="@+id/config_a11y_status"
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/gap_tight"
                android:textColor="?attr/dshaTextSecondary"
                android:text="" />

            <Button
                android:id="@+id/config_battery_opt"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="@dimen/gap_tight"
                android:background="@drawable/bg_btn"
                android:textSize="@dimen/text_body"
                android:text="🔋 关闭电池优化（保活必做）" />

            <TextView
                android:id="@+id/config_battery_opt_hint"
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/gap_tight"
                android:textColor="?attr/dshaTextSecondary"
                android:text="系统休眠会冻结后台网络，ADB 连接因此断掉且无法自动恢复。加入白名单后保活才真正生效。" />

            <CheckBox
                android:id="@+id/config_dev_bridge"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:minHeight="@dimen/touch_min"
                android:text="开发者直连（ADB）" />

            <TextView
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_control"
                android:layout_marginBottom="@dimen/gap_tight"
                android:textColor="?attr/dshaTextSecondary"
                android:text="让已授权的 ADB 直接读状态、跑容器命令，用来在真机上定位问题。这是提权：有 ADB 授权的电脑就能执行任意容器命令。每次调用都记进活动日志，排查完请关掉。" />

        </LinearLayout>

        <TextView
            style="@style/DshaText.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:text="更新与维护" />

        <LinearLayout
            style="@style/DshaCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/config_check_update"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:text="启动时检查新版本" />

            <Button
                android:id="@+id/config_runtime_update"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="@dimen/gap_tight"
                android:background="@drawable/bg_btn"
                android:textSize="@dimen/text_body"
                android:text="🔄 检查脚本更新（几十 KB，不用重下整包）" />

            <TextView
                android:id="@+id/config_runtime_status"
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/gap_tight"
                android:textColor="?attr/dshaTextSecondary"
                android:text="" />

        </LinearLayout>

        <TextView
            android:id="@+id/config_repo_link"
            style="@style/DshaText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:gravity="center"
            android:minHeight="@dimen/touch_min"
            android:clickable="true"
            android:focusable="true"
            android:textColor="?attr/dshaTextSecondary"
            android:text="DSHA" />

    </LinearLayout>
</ScrollView>
