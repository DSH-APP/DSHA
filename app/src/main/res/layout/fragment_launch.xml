<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/surface" android:id="@+id/launch_panel">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/page_pad" android:paddingEnd="@dimen/page_pad" android:paddingTop="@dimen/gap_tight" android:paddingBottom="@dimen/gap_section">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_sections" android:orientation="vertical">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_actions" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="44dp" android:layout_height="44dp" android:id="@+id/launch_run_dot" android:importantForAccessibility="no" android:text="@string/ui_status_dot" android:textSize="16sp" android:textColor="@color/ok" android:includeFontPadding="false" android:gravity="center" android:background="@drawable/bg_ok_chip" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="14dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/launch_run_state" android:accessibilityLiveRegion="polite" android:text="@string/ui2_stopped" android:textSize="20sp" android:textColor="@color/text" android:includeFontPadding="false" android:textStyle="bold" android:layout_weight="1" />
                                <TextView android:layout_width="wrap_content" android:layout_height="24dp" android:id="@+id/launch_compat" android:text="@string/ui2_proot_compat" android:textSize="12sp" android:textColor="@color/text_secondary" android:includeFontPadding="false" android:gravity="center" android:paddingLeft="10dp" android:paddingRight="10dp" android:background="@drawable/bg_icon_tile" android:visibility="gone" android:layout_marginStart="8dp" />
                            </LinearLayout>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_subtitle" android:text="@string/ui2_launch_hint" android:textSize="12sp" android:textColor="@color/text_secondary" android:includeFontPadding="false" android:layout_marginTop="5dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_status" android:text="" android:textSize="11sp" android:textColor="@color/text_muted" android:includeFontPadding="false" android:layout_marginTop="8dp" />
                    <ProgressBar android:layout_width="match_parent" android:layout_height="3dp" android:id="@+id/launch_busy" style="?android:attr/progressBarStyleHorizontal" android:indeterminate="true" android:indeterminateTint="@color/primary" android:visibility="gone" />
                    <androidx.appcompat.widget.AppCompatButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_start" android:text="@string/ui2_start_action" android:textSize="16sp" android:textStyle="bold" android:textAllCaps="false" android:gravity="center" android:includeFontPadding="false" android:minHeight="48dp" android:minWidth="0dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/bg_btn_primary" android:textColor="@color/button_primary_text" android:layout_marginTop="16dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_controls" android:orientation="horizontal" android:layout_marginTop="8dp" android:gravity="center_vertical">
                        <androidx.appcompat.widget.AppCompatButton android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/launch_open" android:text="@string/ui2_restart" android:textSize="13sp" android:textStyle="bold" android:textAllCaps="false" android:gravity="center" android:includeFontPadding="false" android:minHeight="48dp" android:minWidth="0dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/bg_btn" android:textColor="@color/text" android:layout_weight="1" />
                        <androidx.appcompat.widget.AppCompatButton android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/launch_stop" android:text="@string/ui2_stop" android:textSize="13sp" android:textStyle="bold" android:textAllCaps="false" android:gravity="center" android:includeFontPadding="false" android:minHeight="48dp" android:minWidth="0dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/bg_btn" android:textColor="@color/err" android:layout_weight="1" android:layout_marginStart="8dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_trouble_row" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui3_launch_trouble" android:textSize="12sp" android:textColor="@color/text_secondary" android:includeFontPadding="false" />
                        <Button android:id="@+id/launch_safe" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.DSHA.TextButton" android:minHeight="44dp" android:minWidth="0dp" android:textSize="13sp" android:textAllCaps="false" android:text="@string/ui_m0007" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" android:text="@string/ui3_sep_dot" android:textSize="13sp" android:textColor="@color/text_muted" android:includeFontPadding="false" />
                        <Button android:id="@+id/launch_recovery" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.DSHA.TextButton" android:minHeight="44dp" android:minWidth="0dp" android:textSize="13sp" android:textAllCaps="false" android:text="@string/ui3_launch_recovery" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:visibility="gone">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:layout_weight="1" android:padding="14dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_port" android:text="@string/ui_status_unavailable" android:textSize="19sp" android:textColor="@color/text" android:includeFontPadding="false" android:fontFamily="monospace" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_port" android:textSize="12sp" android:textColor="@color/text_muted" android:includeFontPadding="false" android:layout_marginTop="8dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:layout_weight="1" android:padding="14dp" android:layout_marginStart="10dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_environment" android:text="@string/ui_status_unavailable" android:textSize="19sp" android:textColor="@color/text" android:includeFontPadding="false" android:fontFamily="monospace" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_environment" android:textSize="12sp" android:textColor="@color/text_muted" android:includeFontPadding="false" android:layout_marginTop="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_address" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginTop="12dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_address" android:textSize="15sp" android:textColor="@color/text" android:includeFontPadding="false" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp" android:minHeight="44dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_local" android:textSize="12sp" android:textColor="@color/text_muted" android:includeFontPadding="false" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_local_value" android:text="@string/ui_status_unavailable" android:textSize="15sp" android:textColor="@color/text" android:includeFontPadding="false" android:fontFamily="monospace" android:layout_marginTop="4dp" android:textIsSelectable="true" />
                        </LinearLayout>
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:id="@+id/launch_copy_local" android:src="@drawable/ic_ui_copy" android:background="@drawable/bg_icon_tile" android:padding="12dp" android:contentDescription="@string/ui2_copy_local" android:clickable="true" android:focusable="true" app:tint="@color/primary" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginTop="12dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp" android:minHeight="44dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_lan_label" android:text="@string/ui2_lan_hint" android:textSize="12sp" android:textColor="@color/text_muted" android:includeFontPadding="false" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_lan_value" android:text="@string/ui2_lan_off" android:textSize="15sp" android:textColor="@color/text" android:includeFontPadding="false" android:fontFamily="monospace" android:layout_marginTop="4dp" android:textIsSelectable="true" />
                        </LinearLayout>
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:id="@+id/launch_copy_lan" android:src="@drawable/ic_ui_copy" android:background="@drawable/bg_icon_tile" android:padding="12dp" android:contentDescription="@string/ui2_copy_lan" android:clickable="true" android:focusable="true" android:visibility="gone" app:tint="@color/primary" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/lan_addr" android:text="" android:textSize="11sp" android:textColor="@color/primary" android:includeFontPadding="false" android:visibility="gone" android:textIsSelectable="true" />
                </LinearLayout>

                <View android:layout_width="0dp" android:layout_height="0dp" android:id="@+id/launch_models" android:visibility="gone" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_log_panel" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginTop="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui2_logs" android:textSize="15sp" android:textColor="@color/text" android:includeFontPadding="false" android:textStyle="bold" android:layout_weight="1" />
                        <Button android:id="@+id/launch_download_logs" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.DSHA.TextButton" android:minHeight="44dp" android:text="@string/ui2_download" />
                        <Button android:id="@+id/launch_log_toggle" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.DSHA.TextButton" android:minHeight="44dp" android:text="@string/ui2_view_all_logs" />
                    </LinearLayout>
                    <com.deepseekharness.app.ui.LogScrollView android:layout_width="match_parent" android:layout_height="56dp" android:id="@+id/launch_log_scroll" android:fillViewport="true" android:background="@drawable/bg_input" android:layout_marginTop="10dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/launch_log" android:text="@string/ui_m0025" android:textSize="12sp" android:textColor="@color/text_secondary" android:includeFontPadding="false" android:fontFamily="monospace" android:textIsSelectable="true" android:padding="12dp" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                    </com.deepseekharness.app.ui.LogScrollView>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/launch_web" android:visibility="gone">
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/launch_web_box" />
    </FrameLayout>
</FrameLayout>
