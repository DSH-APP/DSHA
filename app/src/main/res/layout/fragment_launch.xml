<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface">
    <androidx.core.widget.NestedScrollView android:id="@+id/launch_home" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/page_pad" android:paddingTop="@dimen/gap_tight" android:paddingEnd="@dimen/page_pad" android:paddingBottom="@dimen/gap_control">
            <LinearLayout style="@style/DshaCard" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/launch_run_dot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textColor="@color/text_muted" android:textSize="@dimen/text_caption" />
                    <TextView android:id="@+id/launch_run_state" style="@style/DshaText.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/gap_tight" android:layout_weight="1" android:text="DSH 未运行" />
                </LinearLayout>
                <TextView android:id="@+id/launch_status" style="@style/DshaText.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_tight" android:textColor="@color/text_muted" />
                <ProgressBar android:id="@+id/launch_busy" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="@dimen/progress_thin" android:layout_marginTop="@dimen/gap_tight" android:indeterminate="true" android:indeterminateTint="@color/primary" android:visibility="gone" />
                <LinearLayout android:id="@+id/launch_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_control" android:orientation="horizontal">
                    <Button android:id="@+id/launch_start" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_btn_primary" android:text="启动" android:textAllCaps="false" android:textColor="@color/button_primary_text" android:textSize="@dimen/text_body" android:minHeight="@dimen/btn_height" />
                    <Button android:id="@+id/launch_open" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/gap_tight" android:layout_weight="1" android:background="@drawable/bg_btn" android:text="重启" android:textAllCaps="false" android:textColor="@color/text_secondary" android:textSize="@dimen/text_body" android:minHeight="@dimen/btn_height" />
                    <Button android:id="@+id/launch_stop" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/gap_tight" android:layout_weight="1" android:background="@drawable/bg_btn" android:text="停止" android:textAllCaps="false" android:textColor="@color/err" android:textSize="@dimen/text_body" android:minHeight="@dimen/btn_height" />
                </LinearLayout>
                <Button android:id="@+id/launch_safe" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="安全启动" android:textSize="14sp" style="@style/Widget.DSHA.TextButton" android:layout_marginTop="8dp" />
                <Button android:id="@+id/launch_recovery" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="查看恢复选项" android:textSize="13sp" android:visibility="gone" android:layout_marginTop="8dp" />
                <TextView android:id="@+id/lan_addr" style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_control" android:background="@drawable/bg_chip_clickable" android:clickable="true" android:focusable="true" android:fontFamily="monospace" android:paddingStart="@dimen/gap_control" android:paddingTop="10dp" android:paddingEnd="@dimen/gap_control" android:paddingBottom="10dp" android:textColor="@color/primary" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="@dimen/gap_control" android:layout_weight="1" android:background="@drawable/bg_preview" android:orientation="vertical" android:minHeight="220dp">
                <TextView style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="@dimen/card_pad" android:paddingTop="@dimen/gap_control" android:paddingEnd="@dimen/card_pad" android:paddingBottom="@dimen/gap_hair" android:letterSpacing="0.04" android:text="日志 · dsh-web.log" />
                <ScrollView android:id="@+id/launch_log_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
                    <TextView android:id="@+id/launch_log" style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:paddingStart="@dimen/card_pad" android:paddingTop="@dimen/gap_hair" android:paddingEnd="@dimen/card_pad" android:paddingBottom="@dimen/card_pad" android:text="还没有日志。" android:textColor="@color/text_secondary" android:textIsSelectable="true" />
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout android:id="@+id/launch_web" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" android:visibility="gone">
        <FrameLayout android:id="@+id/launch_web_box" android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>
</FrameLayout>
