<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface">
    <FrameLayout android:id="@+id/launch_home" android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:id="@+id/launch_sections" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="@dimen/page_pad" android:paddingTop="@dimen/gap_tight" android:paddingEnd="@dimen/page_pad" android:paddingBottom="@dimen/gap_control">
            <LinearLayout android:id="@+id/launch_actions" style="@style/DshaCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/launch_run_dot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textColor="@color/text_muted" android:textSize="@dimen/text_caption" />
                    <TextView android:id="@+id/launch_run_state" style="@style/DshaText.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/gap_tight" android:layout_weight="1" android:maxLines="2" android:ellipsize="end" android:text="@string/ui_m0034" />
                </LinearLayout>
                <TextView android:id="@+id/launch_status" style="@style/DshaText.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/text_muted" />
                <ProgressBar android:id="@+id/launch_busy" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="@dimen/progress_thin" android:layout_marginTop="@dimen/gap_tight" android:indeterminate="true" android:indeterminateTint="@color/primary" android:visibility="gone" />
                <LinearLayout android:id="@+id/launch_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
                    <Button android:id="@+id/launch_start" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_btn_primary" android:text="@string/ui_m0005" android:textAllCaps="false" android:textColor="@color/button_primary_text" android:paddingStart="4dp" android:paddingEnd="4dp" android:minWidth="0dp" android:maxLines="1" android:textSize="14sp" android:minHeight="@dimen/btn_height" />
                    <Button android:id="@+id/launch_open" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/gap_tight" android:layout_weight="1" android:background="@drawable/bg_btn" android:text="@string/ui_m0027" android:textAllCaps="false" android:textColor="@color/text_secondary" android:paddingStart="4dp" android:paddingEnd="4dp" android:minWidth="0dp" android:maxLines="1" android:textSize="14sp" android:minHeight="@dimen/btn_height" />
                    <Button android:id="@+id/launch_stop" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/gap_tight" android:layout_weight="1" android:background="@drawable/bg_btn" android:text="@string/ui_m0061" android:textAllCaps="false" android:textColor="@color/err" android:paddingStart="4dp" android:paddingEnd="4dp" android:minWidth="0dp" android:maxLines="1" android:textSize="14sp" android:minHeight="@dimen/btn_height" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/launch_safe" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ui_m0007" android:textSize="14sp" style="@style/Widget.DSHA.TextButton" />
                    <Button android:id="@+id/launch_recovery" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ui_m0011" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" style="@style/Widget.DSHA.TextButton" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/launch_log_panel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="@dimen/gap_control" android:layout_weight="1" android:background="@drawable/bg_preview" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="@dimen/card_pad" android:paddingEnd="8dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView style="@style/DshaText.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_m0196" />
                    <Button android:id="@+id/launch_download_logs" style="@style/Widget.DSHA.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_m0046" />
                </LinearLayout>
                <ScrollView android:id="@+id/launch_log_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/lan_addr" style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:background="@drawable/bg_chip_clickable" android:clickable="true" android:focusable="true" android:fontFamily="monospace" android:padding="10dp" android:textColor="@color/primary" android:visibility="gone" />
                    <TextView android:id="@+id/launch_log" style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:paddingStart="@dimen/card_pad" android:paddingTop="@dimen/gap_hair" android:paddingEnd="@dimen/card_pad" android:paddingBottom="@dimen/card_pad" android:text="@string/ui_m0025" android:textColor="@color/text_secondary" android:textIsSelectable="true" />
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout android:id="@+id/launch_web" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" android:visibility="gone">
        <FrameLayout android:id="@+id/launch_web_box" android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>
</FrameLayout>
