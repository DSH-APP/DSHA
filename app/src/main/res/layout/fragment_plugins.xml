<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/dshaSurface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_pad"
        android:paddingEnd="@dimen/page_pad"
        android:paddingTop="2dp"
        android:paddingBottom="@dimen/gap_tight">

        <TextView
            android:id="@+id/btnMarket"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_on"
            android:gravity="center"
            android:text="插件市场"
            android:textColor="?attr/dshaPrimary"
            android:textSize="@dimen/text_label"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnInstalled"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="@dimen/gap_tight"
            android:layout_weight="1"
            android:background="@drawable/bg_tab"
            android:gravity="center"
            android:text="插件管理"
            android:textColor="?attr/dshaTextMuted"
            android:textSize="@dimen/text_label"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSort"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="@dimen/gap_tight"
            android:background="@drawable/bg_tab"
            android:gravity="center"
            android:paddingStart="@dimen/gap_control"
            android:paddingEnd="@dimen/gap_control"
            android:text="排序"
            android:textColor="?attr/dshaTextMuted"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:id="@+id/btnFilter"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="@dimen/gap_tight"
            android:paddingStart="@dimen/gap_control"
            android:paddingEnd="@dimen/gap_control"
            android:gravity="center"
            android:text="筛选"
            android:textColor="?attr/dshaText"
            android:textSize="@dimen/text_label"
            android:background="@drawable/bg_btn" />

        <TextView
            android:id="@+id/btnRefresh"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="@dimen/gap_tight"
            android:background="@drawable/bg_tab"
            android:gravity="center"
            android:text="↻"
            android:textColor="?attr/dshaTextMuted"
            android:textSize="@dimen/text_body" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_pad"
        android:paddingEnd="@dimen/page_pad"
        android:paddingBottom="@dimen/gap_tight"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnExport"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn"
            android:gravity="center"
            android:text="导出插件包"
            android:textColor="?attr/dshaTextSecondary"
            android:textSize="@dimen/text_label" />

        <TextView
            android:id="@+id/btnImport"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/gap_tight"
            android:layout_weight="1"
            android:background="@drawable/bg_btn"
            android:gravity="center"
            android:text="导入插件包"
            android:textColor="?attr/dshaTextSecondary"
            android:textSize="@dimen/text_label" />
    </LinearLayout>

    <!-- 搜索框与「只看自装」同一行。
         那个复选框原先是 match_parent 单占一整行，只为一个开关吃掉一条行高 ——
         它还默认 gone（只在「插件管理」这个 tab 显示），显示时页面会整体往下跳一下。
         放进这一行：搜索框吃剩余宽度，复选框 wrap_content 靠右；
         gone 的时候 weight 重算，搜索框自然占满，跟原来一模一样。
         文案从「隐藏自带插件（只看自己装的）」缩成「过滤原装」—— 同行放不下那么长。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_pad"
        android:layout_marginEnd="@dimen/page_pad"
        android:layout_marginBottom="@dimen/gap_tight"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/pluginSearch"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="搜索插件名称…"
            android:imeOptions="actionSearch"
            android:paddingStart="@dimen/card_pad"
            android:paddingEnd="@dimen/card_pad"
            android:singleLine="true"
            android:textColor="?attr/dshaText"
            android:textColorHint="?attr/dshaTextMuted"
            android:textSize="@dimen/text_body" />

        <CheckBox
            android:id="@+id/chkHideBuiltin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_tight"
            android:buttonTint="?attr/dshaPrimary"
            android:text="过滤原装"
            android:textColor="?attr/dshaTextSecondary"
            android:textSize="@dimen/text_label"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 多选操作条：长按插件卡片才进入多选，平时不占任何位置（不加常驻入口） -->
    <LinearLayout
        android:id="@+id/multiBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gap_tight"
        android:paddingEnd="@dimen/gap_tight"
        android:paddingTop="@dimen/gap_tight"
        android:paddingBottom="@dimen/gap_tight"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/multiCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="已选 0 个"
                android:textColor="?attr/dshaTextSecondary"
                android:textSize="@dimen/text_label" />

            <TextView
                android:id="@+id/multiSelectAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn"
                android:gravity="center"
                android:minWidth="64dp"
                android:text="全选"
                android:textColor="?attr/dshaTextSecondary"
                android:textSize="@dimen/text_label" />

            <TextView
                android:id="@+id/multiCancel"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="@dimen/gap_tight"
                android:background="@drawable/bg_btn"
                android:gravity="center"
                android:minWidth="64dp"
                android:text="退出"
                android:textColor="?attr/dshaTextSecondary"
                android:textSize="@dimen/text_label" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/multiEnable"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn"
                android:gravity="center"
                android:text="启用"
                android:textColor="?attr/dshaTextSecondary"
                android:textSize="@dimen/text_label" />

            <TextView
                android:id="@+id/multiDisable"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/gap_tight"
                android:layout_weight="1"
                android:background="@drawable/bg_btn"
                android:gravity="center"
                android:text="禁用"
                android:textColor="?attr/dshaTextSecondary"
                android:textSize="@dimen/text_label" />

            <TextView
                android:id="@+id/multiExport"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/gap_tight"
                android:layout_weight="1"
                android:background="@drawable/bg_btn"
                android:gravity="center"
                android:text="导出"
                android:textColor="?attr/dshaTextSecondary"
                android:textSize="@dimen/text_label" />

            <TextView
                android:id="@+id/multiDelete"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/gap_tight"
                android:layout_weight="1"
                android:background="@drawable/bg_btn"
                android:gravity="center"
                android:text="删除"
                android:textColor="?attr/dshaTextSecondary"
                android:textSize="@dimen/text_label" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pluginList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="8dp" />

    <ProgressBar
        android:id="@+id/pluginBusy"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="?attr/dshaPrimary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/gap_control"
        android:text="加载中…"
        android:textColor="?attr/dshaTextMuted"
        android:textSize="@dimen/text_caption" />
</LinearLayout>
