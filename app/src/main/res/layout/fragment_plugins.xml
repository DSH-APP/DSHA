<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/pluginScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/page_pad">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_polished_card" android:padding="2dp">
            <TextView android:id="@+id/btnMarket" style="@style/PluginAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:background="@drawable/bg_plugin_segment" android:text="@string/ui_m0133" android:minHeight="48dp" android:layout_marginStart="0dp" />
            <TextView android:id="@+id/btnInstalled" style="@style/PluginAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="0dp" android:background="@drawable/bg_plugin_segment" android:text="@string/ui_m0135" android:minHeight="48dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_control" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView style="@style/DshaText.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="@dimen/gap_tight" android:text="@string/ui_m0083" />
            <TextView android:id="@+id/btnRefresh" style="@style/PluginAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="120dp" android:minHeight="48dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:drawableStart="@drawable/ic_plugin_scan" android:drawablePadding="8dp" android:background="@drawable/bg_polished_action" android:text="@string/ui_m0159" android:singleLine="true" android:textColor="@color/primary" android:contentDescription="@string/ui_m0158" />
        </LinearLayout>
        <LinearLayout android:id="@+id/installedControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <EditText android:id="@+id/pluginSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:background="@drawable/bg_input" android:hint="@string/ui_m0138" android:singleLine="true" android:imeOptions="actionDone" android:inputType="text" android:padding="@dimen/gap_control" android:textColor="@color/text" android:textColorHint="@color/text_muted" android:textSize="@dimen/text_body" android:layout_marginTop="12dp" android:drawableStart="@drawable/ic_ui_search" android:drawablePadding="12dp" />
            <CheckBox android:id="@+id/chkHideBuiltin" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="@dimen/gap_hair" android:text="@string/ui_m0081" android:buttonTint="@color/primary" android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" />
            <TextView android:id="@+id/pluginCount" style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="8dp" android:baselineAligned="false" android:layout_marginBottom="@dimen/gap_control">
                <Button android:id="@+id/btnSort" style="@style/Widget.DSHA.Button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:minHeight="52dp" android:text="@string/plugin_sort_az" android:textSize="14sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:drawableEnd="@drawable/ic_ui_chevron" android:drawablePadding="4dp" />
                <Button android:id="@+id/btnPluginUpdates" style="@style/Widget.DSHA.Button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:minHeight="52dp" android:layout_marginStart="8dp" android:text="@string/ui_m0018" android:textSize="14sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/action_text" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout style="@style/DshaCard" android:id="@+id/pluginMarketCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_polished_card">
            <LinearLayout android:id="@+id/pluginWebsiteSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/DshaText.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_m0106" android:layout_weight="1" />
                <Button android:id="@+id/btnPluginWebsite" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="0dp" android:text="@string/ui_m0162" style="@style/Widget.DSHA.TextButton" />
            </LinearLayout>
            <LinearLayout android:id="@+id/pluginLinkSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:orientation="vertical">
                <TextView style="@style/DshaText.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_m0137" android:layout_marginTop="8dp" />
                <EditText android:id="@+id/appbar_github_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="@dimen/gap_control" android:background="@drawable/bg_input" android:hint="@string/ui_m0137" android:inputType="textUri" android:imeOptions="actionGo" android:singleLine="true" android:importantForAutofill="no" android:padding="@dimen/gap_control" android:textColor="@color/text" android:textColorHint="@color/text_muted" android:textSize="@dimen/text_body" android:drawableStart="@drawable/ic_ui_link" android:drawablePadding="12dp" />
                <TextView android:id="@+id/pluginLinkHint" style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_tight" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_control" android:orientation="horizontal">
                    <TextView android:id="@+id/btnPluginPaste" style="@style/Widget.DSHA.ToolbarAction" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_m0179" android:layout_weight="1" android:background="@drawable/bg_polished_action" android:drawableStart="@drawable/ic_ui_copy" android:drawablePadding="8dp" android:minHeight="52dp" />
                    <TextView android:id="@+id/btnPluginInstall" style="@style/PluginAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="@dimen/gap_tight" android:text="@string/ui_m0184" android:background="@drawable/bg_polished_primary" android:textColor="@color/polished_primary_text" android:minHeight="52dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <ProgressBar android:id="@+id/pluginBusy" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="@dimen/gap_control" android:indeterminate="true" android:indeterminateTint="@color/primary" android:visibility="gone" />
        <TextView android:id="@+id/statusText" style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" android:maxLines="2" android:ellipsize="end" android:minHeight="44dp" android:paddingTop="@dimen/gap_hair" android:paddingBottom="@dimen/gap_hair" android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_m0134" android:gravity="center_vertical" />
        <Button android:id="@+id/btnCancelPluginTask" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:text="@string/ui_m0079" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
            <TextView android:id="@+id/btnImport" style="@style/Widget.DSHA.ToolbarAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/ui_m0108" android:textColor="@color/primary" android:background="@drawable/bg_polished_action" android:drawableStart="@drawable/ic_ui_import" android:drawablePadding="8dp" android:minHeight="52dp" />
            <TextView android:id="@+id/btnExport" style="@style/Widget.DSHA.ToolbarAction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="@dimen/gap_tight" android:text="@string/ui_m0009" android:textColor="@color/primary" android:background="@drawable/bg_polished_action" android:drawableStart="@drawable/ic_ui_export" android:drawablePadding="8dp" android:minHeight="52dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
            <TextView android:id="@+id/btnImportFallback" style="@style/Widget.DSHA.ToolbarAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="@string/ui_m0070" android:textColor="@color/text_secondary" android:paddingStart="0dp" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:layout_marginStart="12dp" android:background="@color/panel_outline" />
        </LinearLayout>
        <LinearLayout android:id="@+id/marketHelp" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_polished_card" android:layout_marginTop="8dp">
            <TextView style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_m0056" android:textStyle="bold" android:drawableStart="@drawable/ic_ui_info" android:drawablePadding="10dp" android:gravity="center_vertical" android:textSize="14sp" />
            <TextView style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/ui_m0105" android:textSize="14sp" />
        </LinearLayout>
        <Button android:id="@+id/btnPluginRestore" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/gap_control" android:visibility="gone" android:text="@string/ui_m0104" />
        <TextView android:id="@+id/pluginEmpty" style="@style/DshaText.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/card_pad" android:gravity="center" android:visibility="gone" android:textColor="@color/text_muted" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/pluginList" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
