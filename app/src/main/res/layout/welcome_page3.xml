<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad_wide"
        android:paddingEnd="@dimen/page_pad_wide"
        android:paddingTop="56dp"
        android:paddingBottom="@dimen/gap_section">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_m0044"
            android:textColor="@color/text"
            android:textSize="@dimen/text_display"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight"
            android:layout_marginBottom="@dimen/gap_section"
            android:text="@string/ui_m0071"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_label" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/gap_section" android:orientation="horizontal">
            <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_chip" android:gravity="center" android:text="1" android:textColor="@color/primary" android:textStyle="bold" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/gap_control" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_m0176" android:textColor="@color/text" android:textSize="@dimen/text_body" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/ui_m0045" android:textColor="@color/text_muted" android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/gap_section" android:orientation="horizontal">
            <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_chip" android:gravity="center" android:text="2" android:textColor="@color/primary" android:textStyle="bold" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/gap_control" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_m0097" android:textColor="@color/text" android:textSize="@dimen/text_body" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/ui_m0075" android:textColor="@color/text_muted" android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/gap_section" android:orientation="horizontal">
            <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_chip" android:gravity="center" android:text="3" android:textColor="@color/primary" android:textStyle="bold" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/gap_control" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_m0086" android:textColor="@color/text" android:textSize="@dimen/text_body" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/ui_m0074" android:textColor="@color/text_muted" android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/ui_m0183"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_caption" />

        <Button
            android:id="@+id/welcome_about"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/gap_tight"
            android:background="?attr/selectableItemBackground"
            android:text="@string/ui_m0069"
            android:textAllCaps="false"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_label" />
    </LinearLayout>
</ScrollView>
