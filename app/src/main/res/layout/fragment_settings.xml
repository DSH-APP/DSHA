<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/dshaSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad"
        android:paddingEnd="@dimen/page_pad"
        android:paddingTop="@dimen/gap_tight"
        android:paddingBottom="@dimen/gap_section">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_hair"
            android:layout_marginBottom="@dimen/gap_control"
            android:text="模块"
            android:textAllCaps="true"
            android:textColor="?attr/dshaTextMuted"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/settings_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_hair"
            android:layout_marginTop="@dimen/gap_block"
            android:layout_marginBottom="@dimen/gap_control"
            android:text="其他"
            android:textAllCaps="true"
            android:textColor="?attr/dshaTextMuted"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />

        <com.deepseekharness.app.GlassCard
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/settings_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_pad">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="↻"
                    android:textColor="?attr/dshaTextSecondary"
                    android:textSize="@dimen/text_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_control"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="检查更新"
                        android:textColor="?attr/dshaText"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/settings_update_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_hair"
                        android:text="从 GitHub Releases 检查"
                        android:textColor="?attr/dshaTextMuted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="?attr/dshaTextMuted"
                    android:textSize="@dimen/text_title" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke"
                android:background="?attr/dshaLine" />

            <LinearLayout
                android:id="@+id/settings_selftest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_pad">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="?attr/dshaTextSecondary"
                    android:textSize="@dimen/text_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_control"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="自检 &amp; 修补"
                        android:textColor="?attr/dshaText"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_hair"
                        android:text="桥 · 插件 · 会话 · 备份 · 版本标记"
                        android:textColor="?attr/dshaTextMuted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="?attr/dshaTextMuted"
                    android:textSize="@dimen/text_title" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke"
                android:background="?attr/dshaLine" />

            <LinearLayout
                android:id="@+id/settings_reextract"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_pad">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="⟳"
                    android:textColor="?attr/dshaTextSecondary"
                    android:textSize="@dimen/text_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_control"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="重新解压内置环境"
                        android:textColor="?attr/dshaText"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_hair"
                        android:text="dsh / npm 损坏时用；配置与对话记录会保留"
                        android:textColor="?attr/dshaTextMuted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="?attr/dshaTextMuted"
                    android:textSize="@dimen/text_title" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke"
                android:background="?attr/dshaLine" />

            <LinearLayout
                android:id="@+id/settings_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_pad">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="i"
                    android:textColor="?attr/dshaTextSecondary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_control"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="关于 DSHA"
                        android:textColor="?attr/dshaText"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_hair"
                        android:text="GitHub 仓库 · QQ 交流群 · 开源协议"
                        android:textColor="?attr/dshaTextMuted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="?attr/dshaTextMuted"
                    android:textSize="@dimen/text_title" />
            </LinearLayout>
        </com.deepseekharness.app.GlassCard>

        <TextView
            android:id="@+id/settings_ver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_block"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="DSHA"
            android:textColor="?attr/dshaTextMuted"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>
</ScrollView>
