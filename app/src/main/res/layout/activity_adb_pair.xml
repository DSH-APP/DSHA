<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent" android:fillViewport="true" android:background="@color/surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <Button android:id="@+id/adb_pair_back" style="@style/Widget.DSHA.TextButton" android:layout_width="48dp"
                android:layout_height="48dp" android:text="‹" android:textSize="28sp" android:padding="0dp" android:contentDescription="@string/ui_m0200" />
            <TextView style="@style/DshaText.Display" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_m0031" />
        </LinearLayout>
        <TextView style="@style/DshaText.Label" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="@string/ui_m0206" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/bg_device_card" android:padding="18dp" android:layout_marginTop="18dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="top" android:paddingTop="0dp" android:paddingBottom="6dp">
                <TextView android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/bg_device_number"
                    android:gravity="center" android:text="1" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/primary" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView style="@style/DshaText.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:text="@string/ui_m0117" />
                    <TextView style="@style/DshaText.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/ui_m0092" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="top" android:paddingTop="16dp" android:paddingBottom="6dp">
                <TextView android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/bg_device_number"
                    android:gravity="center" android:text="2" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/primary" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView style="@style/DshaText.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:text="@string/ui_m0127" />
                    <TextView style="@style/DshaText.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/ui_m0205" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="top" android:paddingTop="16dp" android:paddingBottom="6dp">
                <TextView android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/bg_device_number"
                    android:gravity="center" android:text="3" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/primary" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView style="@style/DshaText.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:text="@string/ui_m0195" />
                    <TextView style="@style/DshaText.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/ui_m0059" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="top" android:paddingTop="16dp" android:paddingBottom="6dp">
                <TextView android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/bg_device_number"
                    android:gravity="center" android:text="4" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/primary" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView style="@style/DshaText.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:text="@string/ui_m0207" />
                    <TextView style="@style/DshaText.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/ui_m0167" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/bg_device_tint" android:padding="18dp" android:layout_marginTop="16dp">
            <TextView style="@style/DshaText.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_m0149" />
            <TextView style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/ui_m0151" />
            <EditText android:id="@+id/adb_pair_code" android:layout_width="match_parent" android:layout_height="64dp"
                android:layout_marginTop="14dp" android:background="@drawable/bg_device_card" android:padding="12dp"
                android:gravity="center" android:hint="@string/ui_m0029" android:textSize="24sp" android:textColor="@color/text"
                android:inputType="number" android:digits="0123456789" android:maxLength="6" android:singleLine="true"
                android:saveEnabled="false" android:importantForAutofill="no" />
        </LinearLayout>
        <Button android:id="@+id/adb_pair_start" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:minHeight="52dp" android:background="@drawable/bg_btn_primary"
            android:textColor="@color/button_primary_text" android:text="@string/ui_m0010" />
        <Button android:id="@+id/adb_pair_verify" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/bg_polished_action" android:text="@string/ui_m0217" />
        <Button android:id="@+id/adb_pair_auto" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/bg_polished_action" android:text="@string/ui_m0181" />
        <Button android:id="@+id/adb_pair_settings" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/bg_polished_action" android:text="@string/ui_m0128" />
        <Button android:id="@+id/adb_pair_manual" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/bg_polished_action" android:text="@string/ui_m0012" />
        <TextView android:id="@+id/adb_pair_status" style="@style/DshaText.Label" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_device_card"
            android:padding="16dp" android:textIsSelectable="true" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/adb_pair_help" style="@style/Widget.DSHA.TextButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/ui_m0026" />
    </LinearLayout>
</ScrollView>
