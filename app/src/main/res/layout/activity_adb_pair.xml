<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/surface">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingLeft="12dp" android:paddingRight="18dp" android:gravity="center_vertical">
    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/adb_pair_back" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_ui_back" android:contentDescription="@string/ui_m0201" app:tint="@color/text" />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui2_adb" android:textSize="18sp" android:textColor="@color/text" android:includeFontPadding="false" android:textStyle="bold" android:layout_weight="1" android:layout_marginStart="10dp" />
  </LinearLayout>
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_adb" android:textSize="24sp" android:textColor="@color/text" android:includeFontPadding="false" android:textStyle="bold" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_adb_intro" android:textSize="12sp" android:textColor="@color/text_secondary" android:includeFontPadding="false" android:layout_marginTop="6dp" android:layout_marginBottom="18dp" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginBottom="12dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_connection" android:textSize="13sp" android:textColor="@color/text" android:includeFontPadding="false" android:textStyle="bold" />
        <TextView android:id="@+id/adb_pair_status" style="@style/DshaText.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="0dp" android:textIsSelectable="true" android:accessibilityLiveRegion="polite" android:textSize="12sp" />
      </LinearLayout>
      <Button android:id="@+id/adb_pair_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_polished_action" android:text="@string/ui_m0128" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginBottom="12dp" android:layout_marginTop="12dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui134_host" android:textSize="11sp" android:textColor="@color/text" android:includeFontPadding="false" android:layout_marginTop="10dp" android:layout_marginBottom="8dp" />
        <EditText android:id="@+id/adb_pair_host" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:background="@drawable/bg_input" android:padding="12dp" android:textSize="14sp" android:textColor="@color/text" android:hint="@string/ui134_auto_host" android:singleLine="true" android:inputType="textUri" android:saveEnabled="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui134_pair_port" android:textSize="11sp" android:textColor="@color/text" android:includeFontPadding="false" android:layout_marginTop="10dp" android:layout_marginBottom="8dp" />
        <EditText android:id="@+id/adb_pair_port" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:background="@drawable/bg_input" android:padding="12dp" android:textSize="14sp" android:textColor="@color/text" android:hint="@string/ui134_auto_port" android:singleLine="true" android:inputType="number" android:saveEnabled="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_pair_code" android:textSize="11sp" android:textColor="@color/text" android:includeFontPadding="false" android:layout_marginTop="10dp" android:layout_marginBottom="8dp" />
        <EditText android:id="@+id/adb_pair_code" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="14dp" android:background="@drawable/bg_device_card" android:padding="12dp" android:gravity="center" android:hint="@string/ui_m0029" android:textSize="24sp" android:textColor="@color/text" android:inputType="number" android:digits="0123456789" android:maxLength="6" android:singleLine="true" android:saveEnabled="false" android:importantForAutofill="no" />
        <Button android:id="@+id/adb_pair_start" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:minHeight="52dp" android:background="@drawable/bg_btn_primary" android:textColor="@color/button_primary_text" android:text="@string/ui_m0010" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginBottom="12dp">
        <Button android:id="@+id/adb_pair_auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_polished_action" android:text="@string/ui_m0181" />
        <Button android:id="@+id/adb_pair_manual" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_polished_action" android:text="@string/ui_m0012" />
        <Button android:id="@+id/adb_pair_verify" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_polished_action" android:text="@string/ui_m0217" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/adb_pair_disconnect" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ui134_disconnect" style="@style/Widget.DSHA.Button" android:layout_marginTop="10dp" />
        <Button android:id="@+id/adb_pair_help" style="@style/Widget.DSHA.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/ui_m0026" />
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
</LinearLayout>