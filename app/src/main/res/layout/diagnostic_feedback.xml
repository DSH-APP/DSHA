<?xml version="1.0" encoding="utf-8"?>
<!--
  反馈卡：复制报告 / 导出（格式与位置在弹层里选）/ 上次保存的文件。手机与平板共用。
  diagnostic_copy / diagnostic_export / diagnostic_logs_status 的 id 保持不变（行改为可点 LinearLayout）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/ShellCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <LinearLayout android:id="@+id/diagnostic_copy" style="@style/ShellRow" android:layout_width="match_parent" android:layout_height="wrap_content">
    <ImageView style="@style/ShellRowIcon" android:layout_width="@dimen/shell_row_icon" android:layout_height="@dimen/shell_row_icon" android:contentDescription="@null" android:src="@drawable/ic_ui_copy" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
      <TextView style="@style/ShellRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/diag248_copy" />
      <TextView style="@style/ShellRowSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/diag248_copy_sub" />
    </LinearLayout>
  </LinearLayout>
  <View style="@style/ShellDivider" android:layout_marginStart="60dp" />
  <LinearLayout android:id="@+id/diagnostic_export" style="@style/ShellRow" android:layout_width="match_parent" android:layout_height="wrap_content">
    <ImageView style="@style/ShellRowIcon" android:layout_width="@dimen/shell_row_icon" android:layout_height="@dimen/shell_row_icon" android:contentDescription="@null" android:src="@drawable/ic_ui_export" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
      <TextView style="@style/ShellRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/diag248_export" />
      <TextView style="@style/ShellRowSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/diag248_export_sub" />
    </LinearLayout>
    <ImageView android:layout_width="@dimen/shell_row_chevron" android:layout_height="@dimen/shell_row_chevron" android:contentDescription="@null" android:importantForAccessibility="no" android:src="@drawable/ic_ui2_chevron" app:tint="@color/shell_text_muted" />
  </LinearLayout>
  <!--
    测试包专属：反馈与诊断一键导出。标题与说明由 DiagnosticActivity 按应用语言填充；
    正式包（BuildConfig.TEST_PACKAGE=false）整行与分隔线保持 GONE，不显示入口。
  -->
  <View android:id="@+id/diagnostic_feedback_export_divider" style="@style/ShellDivider" android:layout_marginStart="60dp" android:visibility="gone" />
  <LinearLayout android:id="@+id/diagnostic_feedback_export" style="@style/ShellRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone">
    <ImageView style="@style/ShellRowIcon" android:layout_width="@dimen/shell_row_icon" android:layout_height="@dimen/shell_row_icon" android:contentDescription="@null" android:src="@drawable/ic_ui_export" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
      <TextView android:id="@+id/diagnostic_feedback_title" style="@style/ShellRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" />
      <TextView android:id="@+id/diagnostic_feedback_sub" style="@style/ShellRowSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
    </LinearLayout>
    <ImageView android:layout_width="@dimen/shell_row_chevron" android:layout_height="@dimen/shell_row_chevron" android:contentDescription="@null" android:importantForAccessibility="no" android:src="@drawable/ic_ui2_chevron" app:tint="@color/shell_text_muted" />
  </LinearLayout>
  <TextView android:id="@+id/diagnostic_feedback_status" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="48dp" android:paddingStart="60dp" android:paddingTop="10dp" android:paddingEnd="@dimen/shell_row_pad_h" android:paddingBottom="10dp" android:textColor="@color/shell_accent" android:visibility="gone" />
  <!-- 只在有上次保存记录或导出进行中时显示；点按用系统应用打开该文件。 -->
  <View android:id="@+id/diagnostic_logs_divider" style="@style/ShellDivider" android:layout_marginStart="60dp" android:visibility="gone" />
  <TextView android:id="@+id/diagnostic_logs_status" style="@style/ShellStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:minHeight="48dp" android:paddingStart="60dp" android:paddingTop="10dp" android:paddingEnd="@dimen/shell_row_pad_h" android:paddingBottom="10dp" android:textColor="@color/shell_accent" android:visibility="gone" />
</LinearLayout>
