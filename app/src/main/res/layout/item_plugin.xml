<?xml version='1.0' encoding='utf-8'?>
<com.deepseekharness.app.ui.miuix.MiuixPanel xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/gap_control">
    <LinearLayout android:orientation="vertical" android:padding="@dimen/card_pad" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/pluginName" style="@style/DshaText.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans" android:breakStrategy="simple" android:textSize="17sp" android:textStyle="bold" android:accessibilityHeading="true" android:lineSpacingExtra="3dp" />
        <TextView android:id="@+id/pluginDesc" style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_tight" android:maxLines="3" android:ellipsize="end" android:textSize="14sp" />
        <TextView android:id="@+id/pluginStatus" style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/gap_tight" android:lineSpacingExtra="3dp" android:layout_marginTop="8dp" android:textSize="14sp" />
        <com.deepseekharness.app.ui.ActionRow android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_control" android:orientation="horizontal" android:gravity="center_vertical">
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/pluginSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:showText="false" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" />
            <TextView android:id="@+id/pluginActions" style="@style/PluginAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/gap_tight" android:background="@drawable/bg_polished_action" android:text="@string/ui_m0146" android:lineSpacingExtra="3dp" android:minHeight="48dp" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:gravity="center" />
        </com.deepseekharness.app.ui.ActionRow>
        <Button android:id="@+id/pluginExpand" style="@style/Widget.DSHA.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <TextView android:id="@+id/pluginDetails" style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:textIsSelectable="true" android:visibility="gone" android:lineSpacingExtra="3dp" />
        <Button android:id="@+id/pluginDelete" style="@style/Widget.DSHA.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:textColor="@color/err" android:visibility="gone" />
    </LinearLayout>
</com.deepseekharness.app.ui.miuix.MiuixPanel>