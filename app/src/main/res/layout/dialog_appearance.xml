<?xml version="1.0" encoding="utf-8"?>
<!--
  外观面板。三个滑块都要能实时看到效果 —— 透明度、暗化、模糊这类东西讲不清，
  只能看着调，所以拖动时就地预览，松手才落盘。

  主题单选放在最上面：它决定另外几项的意义（不透明主题下调透明度看不出什么）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <RadioGroup
            android:id="@+id/ap_theme_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/ap_theme_default"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:text="默认 · 蓝灰（跟随系统深浅）" />

            <RadioButton
                android:id="@+id/ap_theme_sakura"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:text="樱花 · 暖粉" />
        </RadioGroup>

        <TextView
            style="@style/DshaText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textColor="?attr/dshaTextSecondary"
            android:text="两套配色都跟随系统的浅色/深色模式。" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="?attr/dshaLine" />

        <CheckBox
            android:id="@+id/ap_glass"
            style="@style/DshaText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
            android:text="玻璃效果" />

        <TextView
            style="@style/DshaText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/dshaTextSecondary"
            android:text="顶栏、底栏与卡片会模糊各自背后的内容。叠加在任一配色上，配一张背景图效果最明显。" />

        <TextView
            android:id="@+id/ap_overlay_label"
            style="@style/DshaText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="玻璃浓度" />

        <TextView
            style="@style/DshaText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/dshaTextSecondary"
            android:text="着色的厚度。低了通透但字难读，高了接近实色。" />

        <SeekBar
            android:id="@+id/ap_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/ap_radius_label"
            style="@style/DshaText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="模糊强度" />

        <SeekBar
            android:id="@+id/ap_radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="40" />

        <CheckBox
            android:id="@+id/ap_noise"
            style="@style/DshaText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
            android:text="细噪点（少一点塑料感 · 需重开界面）" />

        <CheckBox
            android:id="@+id/ap_stroke"
            style="@style/DshaText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
            android:text="玻璃描边（勾掉更干净 · 需重开界面）" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="?attr/dshaLine" />

        <TextView
            android:id="@+id/ap_corner_label"
            style="@style/DshaText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="圆角" />

        <TextView
            style="@style/DshaText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/dshaTextSecondary"
            android:text="卡片、按钮、输入框统一改。拖到最左是直角。" />

        <SeekBar
            android:id="@+id/ap_corner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="32" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/dshaLine" />

        <!-- ── 背景图 ── -->
        <TextView
            style="@style/DshaText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="背景图片" />

        <TextView
            android:id="@+id/ap_bg_state"
            style="@style/DshaText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textColor="?attr/dshaTextSecondary"
            android:text="未设置" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/ap_bg_pick"
                style="@style/Widget.DSHA.Button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn"
                android:text="选择图片" />

            <Button
                android:id="@+id/ap_bg_clear"
                style="@style/Widget.DSHA.Button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn"
                android:text="清除" />
        </LinearLayout>

        <!-- ── 三个滑块 ── -->
        <!-- ── 背景图之后直接是玻璃区 ──
             原先这里还有一个「卡片不透明度」滑块，和玻璃区的「玻璃浓度」是两个键。
             拆开的结果是：拖玻璃浓度只有顶栏底栏和卡片在变，终端页、设置页、插件页那些
             普通容器仍然全不透明 —— 用户看到的就是"大部分组件吃不到玻璃效果"。
             通透度对人来说是一个概念，合成一个滑块（玻璃浓度）统管。 -->

        <TextView
            android:id="@+id/ap_filter"
            style="@style/DshaText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_clickable"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_min"
            android:paddingStart="@dimen/gap_control"
            android:paddingEnd="@dimen/gap_control"
            android:text="滤镜 · 原图（不处理）" />

        <TextView
            style="@style/DshaText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/dshaTextSecondary"
            android:text="黑白 / 低饱和 / 复古 / 冷暖调。选「原图」就完全不处理。" />

        <TextView
            android:id="@+id/ap_dim_label"
            style="@style/DshaText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="背景淡化" />

        <TextView
            style="@style/DshaText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/dshaTextSecondary"
            android:text="让背景图与主题底色相融，别抢走注意力。拖到最左是原图。" />

        <SeekBar
            android:id="@+id/ap_dim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="80" />

        <!-- 原先这里还有一个「背景模糊」滑块。它把背景图本身糊掉了，而玻璃的观感恰恰来自
             「清晰的背景 + 糊掉的玻璃区域」这个对比 —— 全糊之后整屏就剩一团雾。
             元素玻璃的模糊程度现在由上面的「模糊强度」一并决定。 -->
    </LinearLayout>
</ScrollView>
