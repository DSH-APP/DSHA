<?xml version="1.0" encoding="utf-8"?>
<!-- 当前会话行内的重命名 / 结束按钮：48dp 触控格内 34dp 强调色圆底（明暗主题都与行底有对比），让按钮有实体感。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/terminal_ripple">
    <item
        android:id="@android:id/mask"
        android:bottom="7dp"
        android:left="7dp"
        android:right="7dp"
        android:top="7dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="7dp"
        android:left="7dp"
        android:right="7dp"
        android:top="7dp">
        <shape android:shape="oval">
            <solid android:color="@color/terminal_accent_soft_2" />
        </shape>
    </item>
</ripple>
