<?xml version="1.0" encoding="utf-8"?>
<!-- 启动日志标题行的 40dp 圆形图标钮：surface 底 + 强描边，按下用 shell ripple。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/shell_nav_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/shell_surface" />
            <stroke android:width="1dp" android:color="@color/shell_line_strong" />
        </shape>
    </item>
</ripple>
