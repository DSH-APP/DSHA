<?xml version="1.0" encoding="utf-8"?>
<!-- 快捷设置磁贴图标。官方要求：24×24dp、纯白、透明背景、VectorDrawable。
     画的是终端提示符「>_」—— 一眼能看出是「跑起一个 shell 环境」而不是别的功能。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <!-- 外框 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M3,4h18c1.1,0 2,0.9 2,2v12c0,1.1 -0.9,2 -2,2H3c-1.1,0 -2,-0.9 -2,-2V6c0,-1.1 0.9,-2 2,-2zM3,6v12h18V6H3z" />
    <!-- 提示符箭头 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M5.7,8.3l1.4,-1.4l3.6,3.6l-3.6,3.6l-1.4,-1.4l2.2,-2.2z" />
    <!-- 光标下划线 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11.5,14.5h6v1.6h-6z" />
</vector>
