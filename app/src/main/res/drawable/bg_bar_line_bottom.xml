<?xml version="1.0" encoding="utf-8"?>
<!--
  顶栏用：只有**下边**一条描边，把栏和内容区分开。

  为什么不直接用 <shape> 加 stroke —— 那会在左右两侧也画出竖线，栏是满宽的，
  屏幕边缘冒出两条短竖线很难看。这里用 layer-list 把上/左/右三边各推出 2dp
  （大于 stroke 宽度），可见区就只剩底边那一条。

  ⚠️ 填充必须是透明的。这张图是给 BlurView 当 background 的，而 BlurView 的绘制顺序是
  「先画模糊 + overlay，再 super.draw() 画 background」—— background 一旦不透明，
  就把刚画好的模糊整块盖掉。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="-2dp"
        android:right="-2dp"
        android:top="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="@dimen/stroke"
                android:color="?attr/dshaLine" />
        </shape>
    </item>
</layer-list>
