<?xml version="1.0" encoding="utf-8"?>
<!-- 输入框：聚焦时描边变主色并加粗，给出"光标在这里"的明确反馈 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/dshaCard" />
            <corners android:radius="@dimen/radius_control" />
            <stroke
                android:width="2dp"
                android:color="?attr/dshaPrimary" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/dshaSurface" />
            <corners android:radius="@dimen/radius_control" />
            <stroke
                android:width="@dimen/stroke"
                android:color="?attr/dshaLine" />
        </shape>
    </item>
</selector>
