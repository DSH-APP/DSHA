<?xml version="1.0" encoding="utf-8"?>
<!-- 运行配置行尾小按钮 / 链接按钮：surface 底 + 细描边，按下有水波；禁用时由 alpha 表达。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/shell_nav_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/shell_surface" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/shell_line_strong" />
        </shape>
    </item>
</ripple>
