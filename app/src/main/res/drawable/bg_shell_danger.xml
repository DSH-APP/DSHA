<?xml version="1.0" encoding="utf-8"?>
<!-- 危险操作：软红底 + 状态色描边；不改变主按钮的语义。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/shell_bad_soft">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/shell_bad_soft" />
            <corners android:radius="@dimen/radius_control" />
            <stroke android:width="1dp" android:color="@color/shell_bad" />
        </shape>
    </item>
</ripple>
