<?xml version="1.0" encoding="utf-8"?>
<!-- 原始视图工具条小胶囊：选中（activated）为 accent_soft 实底，未选中为描边。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/shell_nav_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/shell_launch_radius_pill" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/shell_accent_soft" />
                    <corners android:radius="@dimen/shell_launch_radius_pill" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="@dimen/shell_launch_radius_pill" />
                    <stroke android:width="1dp" android:color="@color/shell_line_strong" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
