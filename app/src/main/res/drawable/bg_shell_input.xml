<?xml version="1.0" encoding="utf-8"?>
<!-- v5 输入框：surface 底、13dp 圆角；聚焦时描边切到强调色并加粗。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/shell_surface" />
            <corners android:radius="@dimen/radius_control" />
            <stroke android:width="2dp" android:color="@color/shell_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/shell_surface" />
            <corners android:radius="@dimen/radius_control" />
            <stroke android:width="1dp" android:color="@color/shell_line" />
        </shape>
    </item>
</selector>
