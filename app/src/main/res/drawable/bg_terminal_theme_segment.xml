<?xml version="1.0" encoding="utf-8"?>
<!-- 主题三段开关的单段：选中段用面板底 + 强调描边与轨道区分，未选中透明；
     外套 ripple 保证按下有反馈（不能只靠颜色区分选中态）。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/terminal_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/terminal_panel" />
                    <corners android:radius="7dp" />
                    <stroke
                        android:width="@dimen/stroke"
                        android:color="@color/terminal_accent_line" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <corners android:radius="7dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
