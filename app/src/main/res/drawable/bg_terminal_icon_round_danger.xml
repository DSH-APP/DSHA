<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/terminal_danger_soft">
    <item
        android:id="@android:id/mask"
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
