<?xml version="1.0" encoding="utf-8"?>
<!-- 更新通道两段切换（RadioButton 用 state_checked）：选中为白色滑块，未选中透明；放在 bg_plugin_segment_track 轨道里。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/shell_nav_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_checked="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/shell_surface" />
                    <corners android:radius="9dp" />
                    <stroke android:width="1dp" android:color="@color/shell_line" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
