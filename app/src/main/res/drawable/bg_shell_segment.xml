<?xml version="1.0" encoding="utf-8"?>
<!-- 分段控件：选中态用强调色软底，未选中透明；圆角与输入框同一档。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/shell_nav_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/shell_accent_soft" />
                    <corners android:radius="@dimen/radius_control" />
                    <stroke android:width="1dp" android:color="@color/shell_accent" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="@dimen/radius_control" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
