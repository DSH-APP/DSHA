<?xml version="1.0" encoding="utf-8"?>
<!-- 主题图标（Android 13+）的单色图层。
     系统只取形状、颜色由壁纸取色决定，所以这里必须是纯剪影：不能有渐变、不能靠
     多种颜色区分层次，线条也不能太细（缩到 48dp 会糊成一团）。
     画的仍是终端提示符「>_」，和快捷设置磁贴保持同一套视觉。
     viewport 用 108×108（adaptive icon 的标准画布），图形收在中间 66dp 的安全区内 ——
     超出的部分会被各家启动器的形状蒙版裁掉。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 提示符箭头 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M34,38.5l7,-7l18,18l-18,18l-7,-7l11,-11z" />
    <!-- 光标下划线 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M62,62h20v8h-20z" />
</vector>
