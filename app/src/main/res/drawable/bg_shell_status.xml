<?xml version='1.0' encoding='utf-8'?>
<!-- 三格状态与日志框：surface 底 + 1dp 描边，圆角比卡片小一档（对比度按 surface 校验）。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/shell_surface" />
    <corners android:radius="@dimen/shell_launch_radius_status" />
    <stroke android:width="1dp" android:color="@color/shell_line" />
</shape>
