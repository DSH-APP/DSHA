<resources>
    <style name="Animation.DSHA.Dialog" parent="">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>
    <!-- 底部弹层：贴底滑入，与居中弹窗分开；CardSheet 在 create() 里挂载。 -->
    <style name="Animation.DSHA.Sheet" parent="">
        <item name="android:windowEnterAnimation">@anim/sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/sheet_exit</item>
    </style>
    <!-- 二级 Activity 的进入/退出：与 Fragment 页面同一套淡入上移，返回只淡出。 -->
    <style name="Animation.DSHA.Activity" parent="">
        <item name="android:activityOpenEnterAnimation">@anim/page_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/page_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/page_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/page_exit</item>
    </style>
    <style name="Widget.DSHA.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:background">@drawable/bg_dialog_button</item>
        <item name="backgroundTint">@null</item><item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/action_text</item>
        <item name="android:textAllCaps">false</item><item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center</item><item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">20dp</item><item name="android:paddingRight">20dp</item>
        <item name="android:paddingTop">12dp</item><item name="android:paddingBottom">12dp</item>
    </style>
    <style name="TextAppearance.DSHA.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/text</item><item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
    </style>
    <style name="TextAppearance.DSHA.DialogBody" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">@color/text_secondary</item><item name="android:textSize">15sp</item>
    </style>
</resources>
