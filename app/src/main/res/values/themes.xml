<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DeepseekHarness" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <!-- 主题可换的颜色槽（声明在 attrs.xml）。这一份映射回原来的取值，
             所以默认外观一个像素都不变；换主题时只有下面这些槽被覆盖。 -->
        <item name="dshaSurface">@color/surface</item>
        <item name="dshaCard">@color/card</item>
        <item name="dshaRaised">@color/raised</item>
        <item name="dshaLine">@color/line</item>
        <item name="dshaPreview">@color/preview</item>
        <item name="dshaText">@color/text</item>
        <item name="dshaTextSecondary">@color/text_secondary</item>
        <item name="dshaTextMuted">@color/text_muted</item>
        <item name="dshaPrimary">@color/primary</item>
        <item name="dshaAccentOn">@color/accent_on</item>
        <item name="dshaOk">@color/ok</item>
        <item name="dshaWarn">@color/warn</item>
        <item name="dshaErr">@color/err</item>
        <item name="dshaErrBg">@color/err_bg</item>
        <item name="dshaRipple">@color/ripple</item>
        <item name="dshaDisabled">@color/disabled</item>
        <item name="dshaWindowBackground">@color/surface</item>

        <item name="colorOnPrimary">@color/accent_on</item>
        <item name="colorPrimaryContainer">@color/raised</item>
        <item name="colorOnPrimaryContainer">@color/primary</item>
        <item name="colorSecondary">@color/primary_dark</item>
        <!-- 底栏选中指示 / 芯片选中底色走这两个（不给的话 Material 会自己算一个
             紫色系默认值，跟本 App 的蓝灰配色打架） -->
        <item name="colorSecondaryContainer">@color/ripple</item>
        <item name="colorOnSecondaryContainer">@color/primary</item>
        <!-- 表面层级：卡片=card，次级容器=raised，描边=line。
             Switch / CheckBox / Slider / AlertDialog 都吃这几个语义色，
             补齐后系统控件才会和自绘的卡片按钮同色系。 -->
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorSurfaceVariant">@color/raised</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/line</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="colorError">@color/err</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorControlHighlight">@color/ripple</item>

        <item name="android:colorBackground">@color/surface</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>

        <!-- 弹窗圆角/配色跟随 App（系统默认弹窗是直角 + 紫色按钮）。
             两条各管一路：alertDialogTheme 管 appcompat/framework 的 AlertDialog，
             materialAlertDialogTheme 管 MaterialAlertDialogBuilder。 -->
        <item name="alertDialogTheme">@style/Dialog.DSHA.Alert</item>
        <item name="materialAlertDialogTheme">@style/Dialog.DSHA.Material</item>

        <!-- 关键：Material3 主题会把布局里的 <Button> 自动膨胀成 MaterialButton，
             而 MaterialButton 的默认样式是 filled —— 它用 backgroundTint=colorPrimary
             填充背景，**直接忽略 android:background**。
             结果在深色模式下就是「浅蓝底（primary #7DA7F4）+ 浅灰字
             （text_secondary #A6B0C3）」，对比度约 1.3:1，根本看不清写了什么。
             用户实测反馈的正是「设置里 ADB 设备通道的所有按钮」。

             改成 Widget.DSHA.Button：backgroundTint 置空，让各布局自己声明的
             bg_btn / bg_btn_primary 真正生效。这些 drawable 本身已经带 ripple
             和禁用态，所以不损失 Material 的交互反馈。
             一处覆盖，全项目 12+ 个 <Button> 一起修好。 -->
        <item name="materialButtonStyle">@style/Widget.DSHA.Button</item>
    </style>

    <!-- appcompat / framework AlertDialog：必须是完整 Dialog 主题（不能给 Overlay） -->
    <style name="Dialog.DSHA.Alert" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="shapeAppearanceOverlay">@style/Shape.DSHA.Dialog</item>
    </style>

    <!-- MaterialAlertDialogBuilder 专用（必须是 ThemeOverlay） -->
    <style name="Dialog.DSHA.Material" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="shapeAppearanceOverlay">@style/Shape.DSHA.Dialog</item>
    </style>

    <style name="Shape.DSHA.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_card</item>
    </style>

    <!-- ============ 可选外观 ============
         都继承 Theme.DeepseekHarness，只覆盖颜色槽 —— 别在这里重复写
         materialButtonStyle 之类的行为配置，那些一旦分叉就会两边不一致
         （本项目在「同一份配置散落两处」上栽过几次）。 -->

    <!-- 樱花：浅色暖粉。取色自一份参考设计（#d4879e 主色 / #5c3344 文字），
         比原来的蓝灰更柔和。这一份是浅色，深色在 values-night 里。 -->
    <style name="Theme.DeepseekHarness.Sakura" parent="Theme.DeepseekHarness">
        <item name="dshaSurface">@color/sk_surface</item>
        <item name="dshaCard">@color/sk_card</item>
        <item name="dshaRaised">@color/sk_raised</item>
        <item name="dshaLine">@color/sk_line</item>
        <item name="dshaPreview">@color/sk_raised</item>
        <item name="dshaText">@color/sk_text</item>
        <item name="dshaTextSecondary">@color/sk_sub</item>
        <item name="dshaTextMuted">@color/sk_muted</item>
        <item name="dshaPrimary">@color/sk_primary</item>
        <item name="dshaAccentOn">#FFFFFF</item>
        <item name="dshaOk">@color/sk_ok</item>
        <item name="dshaWarn">@color/sk_warn</item>
        <item name="dshaErr">@color/sk_primary</item>
        <item name="dshaRipple">@color/sk_ripple</item>
        <item name="dshaWindowBackground">@drawable/bg_window_sakura</item>

        <item name="colorPrimary">@color/sk_primary</item>
        <item name="colorSurface">@color/sk_card</item>
        <item name="colorOnSurface">@color/sk_text</item>
        <item name="colorSurfaceVariant">@color/sk_raised</item>
        <item name="colorOnSurfaceVariant">@color/sk_sub</item>
        <item name="colorOutline">@color/sk_line</item>
        <item name="colorOutlineVariant">@color/sk_line</item>
        <item name="colorControlHighlight">@color/sk_ripple</item>
        <item name="android:colorBackground">@color/sk_surface</item>
        <item name="android:windowBackground">@drawable/bg_window_sakura</item>
        <item name="android:statusBarColor">@color/sk_surface</item>
        <item name="android:navigationBarColor">@color/sk_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/sk_text</item>
        <item name="android:textColorSecondary">@color/sk_sub</item>
        <item name="android:textColorHint">@color/sk_muted</item>
    </style>

</resources>
