<?xml version="1.0" encoding="utf-8"?>
<!--
  文本与容器样式：字号/颜色/行距成套定义，布局引用 style 而不是各自硬编码。
  之前同样是"页面标题"，启动页 15sp、市场页 22sp、解压页 21sp，字号阶梯断裂。
-->
<resources>

    <!-- 页面主标题（每页顶部只有一个） -->
    <style name="DshaText.Display" parent="">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/dshaText</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- 区块标题（卡片内的小节名） -->
    <style name="DshaText.Title" parent="">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/dshaText</item>
    </style>

    <!-- 正文 -->
    <style name="DshaText.Body" parent="">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">?attr/dshaText</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <!-- 次要说明 -->
    <style name="DshaText.Label" parent="">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">?attr/dshaTextSecondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- 辅助信息 / 脚注 -->
    <style name="DshaText.Caption" parent="">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">?attr/dshaTextMuted</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- 卡片容器：统一底色、圆角、内边距 -->
    <style name="DshaCard" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/card_pad</item>
        <item name="android:orientation">vertical</item>
    </style>


    <!-- 让 <Button> 回到「尊重 android:background」的行为。
         定义在 styles.xml（不分 day/night）而不是某一份 themes.xml ——
         深色模式有独立的 values-night/themes.xml，配置写在单边会漏，
         本项目已经在「同一份配置散落两处」上栽过几次
         （补丁标记版本不同步、插件安置两套实现并存）。 -->
    <style name="Widget.DSHA.Button" parent="Widget.Material3.Button.TextButton">
        <item name="backgroundTint">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/dshaText</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">?attr/dshaRipple</item>
    </style>
</resources>
