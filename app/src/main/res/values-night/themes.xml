<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DeepseekHarness" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <!-- 主题可换的颜色槽（声明在 attrs.xml）。这一份映射回原来的取值，
             所以默认外观一个像素都不变；换主题时只有下面这些槽被覆盖。 -->
        <item name="dshaSurface">@color/surface</item>
        <item name="dshaCard">@color/card</item>
        <item name="dshaRaised">@color/raised</item>
        <item name="dshaLine">@color/line</item>
        <item name="dshaPreview">@color/preview</item>
        <item name="dshaText">@color/text</item>
        <item name="dshaTextSecondary">@color/text_secondary</item>
        <item name="dshaTextMuted">@color/text_muted</item>
        <item name="dshaPrimary">@color/primary</item>
        <item name="dshaAccentOn">@color/accent_on</item>
        <item name="dshaOk">@color/ok</item>
        <item name="dshaWarn">@color/warn</item>
        <item name="dshaErr">@color/err</item>
        <item name="dshaErrBg">@color/err_bg</item>
        <item name="dshaRipple">@color/ripple</item>
        <item name="dshaDisabled">@color/disabled</item>
        <item name="dshaWindowBackground">@color/surface</item>

        <item name="colorOnPrimary">@color/accent_on</item>
        <item name="colorPrimaryContainer">@color/raised</item>
        <item name="colorOnPrimaryContainer">@color/primary</item>
        <item name="colorSecondary">@color/primary_dark</item>
        <item name="colorSecondaryContainer">@color/ripple</item>
        <item name="colorOnSecondaryContainer">@color/primary</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorSurfaceVariant">@color/raised</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/line</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="colorError">@color/err</item>
        <item name="colorOnError">#1A0F0F</item>
        <item name="colorControlHighlight">@color/ripple</item>

        <item name="android:colorBackground">@color/surface</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>

        <item name="alertDialogTheme">@style/Dialog.DSHA.Alert</item>
        <item name="materialAlertDialogTheme">@style/Dialog.DSHA.Material</item>

        <!-- 必须和 values/themes.xml 保持一致：Material3 会把 <Button> 膨胀成
             MaterialButton 并用 backgroundTint=colorPrimary 填充，忽略
             android:background。深色模式下 primary 是浅蓝 #7DA7F4，
             配 text_secondary #A6B0C3 对比度只有约 1.3:1 —— 就是用户看到的
             「浅蓝底白字看不清」。上一版只改了 day 那份，深色模式毫无变化。 -->
        <item name="materialButtonStyle">@style/Widget.DSHA.Button</item>
    </style>

    <!-- 樱花 · 深色。跟 values/themes.xml 里那份同名，系统进夜间模式时自动换到这边。
         只覆盖颜色槽，行为配置（materialButtonStyle 等）由 parent 带过来。 -->
    <style name="Theme.DeepseekHarness.Sakura" parent="Theme.DeepseekHarness">
        <item name="dshaSurface">@color/sk_dark_surface</item>
        <item name="dshaCard">@color/sk_dark_card</item>
        <item name="dshaRaised">@color/sk_dark_raised</item>
        <item name="dshaLine">@color/sk_dark_line</item>
        <item name="dshaPreview">@color/sk_dark_raised</item>
        <item name="dshaText">@color/sk_dark_text</item>
        <item name="dshaTextSecondary">@color/sk_dark_sub</item>
        <item name="dshaTextMuted">@color/sk_dark_muted</item>
        <item name="dshaPrimary">@color/sk_primary</item>
        <item name="dshaOk">@color/sk_ok</item>
        <item name="dshaWarn">@color/sk_warn</item>
        <item name="dshaErr">@color/sk_primary</item>
        <item name="dshaRipple">@color/sk_dark_ripple</item>
        <item name="dshaWindowBackground">@color/sk_dark_surface</item>

        <item name="colorPrimary">@color/sk_primary</item>
        <item name="colorSurface">@color/sk_dark_card</item>
        <item name="colorOnSurface">@color/sk_dark_text</item>
        <item name="colorSurfaceVariant">@color/sk_dark_raised</item>
        <item name="colorOnSurfaceVariant">@color/sk_dark_sub</item>
        <item name="colorOutline">@color/sk_dark_line</item>
        <item name="colorOutlineVariant">@color/sk_dark_line</item>
        <item name="colorControlHighlight">@color/sk_dark_ripple</item>
        <item name="android:colorBackground">@color/sk_dark_surface</item>
        <item name="android:windowBackground">@color/sk_dark_surface</item>
        <item name="android:statusBarColor">@color/sk_dark_surface</item>
        <item name="android:navigationBarColor">@color/sk_dark_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/sk_dark_text</item>
        <item name="android:textColorSecondary">@color/sk_dark_sub</item>
        <item name="android:textColorHint">@color/sk_dark_muted</item>
    </style>
</resources>
