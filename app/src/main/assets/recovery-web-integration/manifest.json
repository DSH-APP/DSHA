{
  "manifest_version": 2,
  "name": "DSHA 应急页面语言同步",
  "version": "1.2",
  "browser_specific_settings": {
    "gecko": { "id": "dsha-recovery-locale@dsh.client" }
  },
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "content_scripts": [
    {
      "matches": ["http://localhost/*"],
      "js": ["locale-relay.js"],
      "all_frames": false,
      "run_at": "document_start"
    }
  ]
}
