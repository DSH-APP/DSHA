{
  "schemaVersion": 1,
  "names": {
    "bridgeToken": ".bridge_token",
    "bridgeHeaders": ".bridge_headers",
    "bridgeStatus": ".bridge_status",
    "bridgePort": ".bridge_port",
    "legacyApiKey": ".dsha-apikey"
  },
  "externalMachine": {
    "exact": [
      ".bridge_token",
      ".bridge_headers",
      ".bridge_status",
      ".bridge_port",
      ".anonymous-user-id",
      "bridge-token",
      ".dsha-bridge-token"
    ],
    "prefixes": [
      ".bridge_token.",
      ".bridge_headers.",
      ".bridge_status.",
      ".bridge_port."
    ]
  },
  "backupMachine": {
    "additionalExact": [
      ".plugins.lock",
      ".dsha-web.pid",
      ".dsha-web.identity",
      ".dsha-stopped",
      ".bridge_port",
      "dsha-startup-checkpoints",
      ".offline-extracted",
      ".offline-identity",
      ".offline-version",
      ".runtime-descriptor.json",
      ".runtime-health.json",
      "plugin-activations.json",
      "plugin-safe-mode.json",
      ".dsha-rc1-restore-generation",
      "adbkeys"
    ]
  },
  "externalCredentials": {
    "exact": [
      ".env",
      ".credentials",
      ".dsha-apikey",
      ".npmrc",
      ".yarnrc.yml",
      ".git-credentials",
      ".netrc",
      "id_rsa",
      "id_ed25519",
      "id_ecdsa",
      "id_dsa",
      ".pypirc",
      "credentials.toml",
      ".my.cnf",
      ".pgpass",
      "pgpass",
      ".htpasswd",
      ".gitconfig"
    ],
    "prefixes": [
      ".env.",
      ".credentials.",
      "id_rsa.",
      "id_ed25519.",
      "id_ecdsa.",
      "id_dsa."
    ]
  },
  "externalDeniedGuestPrefixes": [
    "root/.dsha-",
    "root/.config/gh",
    "root/.docker",
    "root/.gnupg",
    "root/.cargo",
    "root/.config/gcloud",
    "root/.kube",
    "root/.aws",
    "root/.ssh"
  ],
  "sessionExclusions": [
    {
      "root": "sessions",
      "relative": ".sessions-trash",
      "recursive": true
    }
  ]
}
