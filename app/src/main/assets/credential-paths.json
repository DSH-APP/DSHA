{
  "schemaVersion": 1,
  "names": {
    "bridgeToken": ".bridge_token",
    "bridgeHeaders": ".bridge_headers",
    "bridgeStatus": ".bridge_status",
    "legacyApiKey": ".dsha-apikey"
  },
  "externalMachine": {
    "exact": [".bridge_token", ".bridge_headers", ".bridge_status", ".anonymous-user-id", "bridge-token", ".dsha-bridge-token"],
    "prefixes": [".bridge_token.", ".bridge_headers.", ".bridge_status."]
  },
  "backupMachine": {
    "additionalExact": [".plugins.lock", ".dsha-web.pid", ".dsha-web.identity", ".dsha-stopped", "dsha-startup-checkpoints", ".offline-extracted", ".offline-identity", ".offline-version", ".runtime-descriptor.json", ".runtime-health.json", "plugin-activations.json", "plugin-safe-mode.json", ".dsha-rc1-restore-generation"]
  },
  "externalCredentials": {
    "exact": [".env", ".credentials", ".dsha-apikey", ".npmrc", ".yarnrc.yml", ".git-credentials"],
    "prefixes": [".env.", ".credentials."]
  },
  "externalDeniedGuestPrefixes": ["root/.dsha-"],
  "sessionExclusions": [{"root": "sessions", "relative": ".sessions-trash", "recursive": true}]
}
